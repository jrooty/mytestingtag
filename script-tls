#!/bin/bash
set -o pipefail

# test_tls_bigip_local_mtls.sh
# Test TLS/TCP/mTLS avec option --local pour BIG-IP localhost:8100 (auth admin:)
# Retourne pool name + host:port + TCP/TLS/mTLS status + ERR/WARN/OK

OPENSSL_TIMEOUT=12
TCP_TIMEOUT=5
SLEEP_MS=200
VERBOSE=0

CLIENT_CERT=""
CLIENT_KEY=""
CA_CERT=""
FILE=""
TARGET=""
DEFAULT_PORT=""
BIGIP_MODE=0
TMP_MEMS=""

sleep_ms() { sleep "$(awk "BEGIN {printf \"%.3f\", $1/1000}")"; }

colorize_status() {
    case "$1" in
        OK) echo -e "\033[0;32m$1\033[0m" ;;
        KO|FAIL) echo -e "\033[0;31m$1\033[0m" ;;
        REQ) echo -e "\033[1;33m$1\033[0m" ;;
        NO|N/A) echo "$1" ;;
        *) echo "$1" ;;
    esac
}

fetch_bigip_local() {
    TMP_JSON=$(mktemp)
    curl -sS -k -u admin: https://localhost:8100/mgmt/tm/ltm/pool?expandSubcollections=true -o "$TMP_JSON" || { echo "Erreur curl"; rm -f "$TMP_JSON"; exit 1; }

    MEMBERS=()
    if command -v jq >/dev/null 2>&1; then
        mapfile -t MEMBERS < <(jq -r '.items[] | .name as $poolname | .membersReference.items[]?.name? | "\($poolname) \(. )"' "$TMP_JSON")
    else
        mapfile -t MEMBERS < <(python3 - <<PY - "$TMP_JSON"
import sys, json
fn=sys.argv[1]
with open(fn) as f:
    j=json.load(f)
for pool in j.get("items",[]):
    pname=pool.get("name")
    for m in pool.get("membersReference",{}).get("items",[]):
        mem=m.get("name")
        if pname and mem:
            print(f"{pname} {mem}")
PY
"$TMP_JSON")
    fi
    rm -f "$TMP_JSON"

    TMP_MEMS=$(mktemp)
    for line in "${MEMBERS[@]}"; do
        POOLNAME="${line%% *}"
        MEMBER="${line#* }"
        HOSTPORT="${MEMBER##*/}"
        if [[ "$HOSTPORT" == *:* ]]; then
            echo "$POOLNAME $HOSTPORT" >> "$TMP_MEMS"
        fi
    done
    FILE="$TMP_MEMS"
}

check_target() {
    local POOLNAME="$1"
    local HOST="$2"
    local PORT="$3"

    local TMP_OUT=$(mktemp)
    local TCP_STATUS="KO"
    local TLS_STATUS="KO"
    local MTLS_STATUS="N/A"
    local IP
    IP=$(getent ahosts "$HOST" 2>/dev/null | awk '/STREAM/ {print $1; exit}')
    [ -z "$IP" ] && IP="(résolution échouée)"

    # TCP
    if timeout $TCP_TIMEOUT bash -c "</dev/tcp/$HOST/$PORT" 2>/dev/null; then TCP_STATUS="OK"; fi

    # TLS + mTLS
    if [ "$TCP_STATUS" = "OK" ]; then
        CMD=(timeout "$OPENSSL_TIMEOUT" openssl s_client -connect "$HOST:$PORT" -servername "$HOST" -showcerts)
        [ -n "$CLIENT_CERT" ] && [ -n "$CLIENT_KEY" ] && CMD+=(-cert "$CLIENT_CERT" -key "$CLIENT_KEY")
        [ -n "$CA_CERT" ] && CMD+=(-CAfile "$CA_CERT")
        "${CMD[@]}" </dev/null >"$TMP_OUT" 2>&1 || true

        if grep -q 'BEGIN CERTIFICATE' "$TMP_OUT"; then
            TLS_STATUS="OK"
        else
            TLS_STATUS="KO"
        fi

        # mTLS detection
        if grep -q "Acceptable client certificate CA names" "$TMP_OUT" || grep -q "SSL alert number 40" "$TMP_OUT"; then
            if [ -n "$CLIENT_CERT" ] && [ -n "$CLIENT_KEY" ]; then
                if grep -q "Verify return code: 0 (ok)" "$TMP_OUT"; then
                    MTLS_STATUS="OK"
                else
                    MTLS_STATUS="FAIL"
                fi
            else
                MTLS_STATUS="REQ"
            fi
        else
            if [ -n "$CLIENT_CERT" ] && [ -n "$CLIENT_KEY" ]; then
                if grep -q "Verify return code: 0 (ok)" "$TMP_OUT"; then
                    MTLS_STATUS="OK"
                else
                    MTLS_STATUS="FAIL"
                fi
            else
                MTLS_STATUS="NO"
            fi
        fi
    else
        TLS_STATUS="KO"
        MTLS_STATUS="N/A"
    fi

    PREFIX=""
    if [ "$TCP_STATUS" != "OK" ] || [ "$TLS_STATUS" != "OK" ] || [ "$MTLS_STATUS" = "FAIL" ]; then
        PREFIX="[ERR] "
    elif [ "$MTLS_STATUS" = "REQ" ]; then
        PREFIX="[WARN] "
    else
        PREFIX="[OK] "
    fi

    if [ "$VERBOSE" -eq 0 ]; then
        echo "${PREFIX}Pool=${POOLNAME} Target=${HOST}:${PORT} (${IP}) TCP=$(colorize_status $TCP_STATUS) TLS=$(colorize_status $TLS_STATUS) mTLS=$(colorize_status $MTLS_STATUS)"
    else
        echo
        echo "=== Test TLS -> Pool=${POOLNAME} Target=${HOST}:${PORT} (${IP}) ==="
        echo "${PREFIX}TCP=${TCP_STATUS} TLS=${TLS_STATUS} mTLS=${MTLS_STATUS}"
        [ -n "$CLIENT_CERT" ] && echo "Cert client fourni: $CLIENT_CERT"
        [ -n "$CA_CERT" ] && echo "CA: $CA_CERT"
        echo "=== Certificat serveur (sommaire) ==="
        awk 'BEGIN{cert=0}/-----BEGIN CERTIFICATE-----/{cert=1;print;next}/-----END CERTIFICATE-----/{if(cert){print;exit}}cert{print}' "$TMP_OUT" >"${TMP_OUT}.pem" 2>/dev/null
        [ -s "${TMP_OUT}.pem" ] && openssl x509 -in "${TMP_OUT}.pem" -noout -subject -issuer -dates || echo "(aucun certificat)"
        rm -f "${TMP_OUT}.pem"
    fi
    rm -f "$TMP_OUT"
}

# ------------------------------
# Argument parsing
# ------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --local) BIGIP_MODE=1; shift ;;
        --verbose) VERBOSE=1; shift ;;
        --sleep-ms) SLEEP_MS="$2"; shift 2 ;;
        --cert|--client-cert) CLIENT_CERT="$2"; shift 2 ;;
        --key|--client-key) CLIENT_KEY="$2"; shift 2 ;;
        --ca) CA_CERT="$2"; shift 2 ;;
        *) echo "Argument inconnu: $1"; exit 1 ;;
    esac
done

# ------------------------------
# Execution
# ------------------------------
if [ "$BIGIP_MODE" -eq 1 ]; then
    fetch_bigip_local
fi

if [ -n "$FILE" ]; then
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        POOLNAME="${line%% *}"
        HOSTPORT="${line#* }"
        HOST="${HOSTPORT%:*}"
        PORT="${HOSTPORT##*:}"
        check_target "$POOLNAME" "$HOST" "$PORT"
        sleep_ms "$SLEEP_MS"
    done < "$FILE"
fi

[ -n "$TMP_MEMS" ] && rm -f "$TMP_MEMS"