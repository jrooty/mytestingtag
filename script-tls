#!/bin/bash
# Test affichage certificat serveur (corrigé pour OpenSSL 1.0.2)

TARGET="$1"
SNI="$2"

IP="${TARGET%%:*}"
PORT="${TARGET##*:}"
[[ -z "$SNI" ]] && SNI="$IP"

echo "[INFO] Connexion à ${IP}:${PORT} (SNI=${SNI})"
TMP=$(mktemp)

# Capture brute
openssl s_client -connect "${IP}:${PORT}" -servername "${SNI}" -showcerts </dev/null >"$TMP" 2>&1

echo
echo "[DEBUG] Extrait du flux brut :"
grep -A2 "BEGIN CERTIFICATE" "$TMP" | head -n 10
echo

# Extraction + nettoyage des \r
awk '/-----BEGIN CERTIFICATE-----/{p=1} p{print} /-----END CERTIFICATE-----/{exit}' "$TMP" \
  | tr -d '\r' > "${TMP}.crt"

if [[ -s "${TMP}.crt" ]]; then
  echo "[INFO] Détails certificat serveur :"
  openssl x509 -in "${TMP}.crt" -noout \
    -subject -issuer -dates -fingerprint -sha256 -ext subjectAltName 2>/dev/null \
    | sed 's/^/  /'
else
  echo "[ERREUR] Aucun certificat extrait !"
fi

rm -f "$TMP" "${TMP}.crt"