#!/bin/bash
#
# Test TLS (avec ou sans authentification mutuelle)
# Usage :
#   ./test_tls.sh <host|file> [port par défaut] [--cert client.crt --key client.key --ca ca.crt] [--verbose]
#
# Dans un fichier : chaque ligne peut être "host" ou "host:port". Lignes vides ou # commentées ignorées.
#

# ==============================
# Fonctions utilitaires
# ==============================

check_target() {
  local HOST=$1
  local PORT=$2

  local CLIENT_CERT=$3
  local CLIENT_KEY=$4
  local CA_CERT=$5
  local VERBOSE=$6

  local TMP_OUT=$(mktemp)
  local TCP_STATUS="KO"
  local TLS_STATUS="KO"
  local MTLS_STATUS="N/A"

  # Résolution DNS → IP
  IP=$(getent ahosts "$HOST" | awk '/STREAM/ {print $1; exit}')
  [ -z "$IP" ] && IP="(résolution échouée)"

  # Test TCP
  if timeout 5 bash -c "</dev/tcp/$HOST/$PORT" 2>/dev/null; then
    TCP_STATUS="OK"
  fi

  # Test TLS si TCP OK
  if [ "$TCP_STATUS" = "OK" ]; then
    local CMD="openssl s_client -connect ${HOST}:${PORT} -servername ${HOST} -brief"
    [ -n "$CLIENT_CERT" ] && [ -n "$CLIENT_KEY" ] && CMD+=" -cert ${CLIENT_CERT} -key ${CLIENT_KEY}"
    [ -n "$CA_CERT" ] && CMD+=" -CAfile ${CA_CERT}"
    eval "$CMD" </dev/null >"$TMP_OUT" 2>&1

    # Détecte si handshake TLS a produit un session (Protocol/Cipher présent)
    if grep -q -E 'Protocol:|Cipher:' "$TMP_OUT"; then
      TLS_STATUS="OK"
    else
      TLS_STATUS="KO"
    fi

    # Détecte si le serveur demande un certificat client
    if grep -q "Acceptable client certificate CA names" "$TMP_OUT" || grep -q "SSL alert number 40" "$TMP_OUT"; then
      # serveur demande mTLS
      if [ -n "$CLIENT_CERT" ] && [ -n "$CLIENT_KEY" ]; then
        # on a fourni un cert client : regarde si handshake avec client a réussi
        if [ "$TLS_STATUS" = "OK" ]; then
          MTLS_STATUS="OK"
        else
          MTLS_STATUS="FAIL"
        fi
      else
        MTLS_STATUS="REQ"
      fi
    else
      # serveur ne demande pas mTLS
      if [ -n "$CLIENT_CERT" ] && [ -n "$CLIENT_KEY" ]; then
        # client fourni mais pas exigé par le serveur : si TLS ok => OK, sinon FAIL
        if [ "$TLS_STATUS" = "OK" ]; then
          MTLS_STATUS="OK"
        else
          MTLS_STATUS="FAIL"
        fi
      else
        MTLS_STATUS="NO"
      fi
    fi
  fi

  # Mode condensé
  if [ $VERBOSE -eq 0 ]; then
    # inclut l'info sur le cert client fourni si applicable
    if [ -n "$CLIENT_CERT" ] && [ -n "$CLIENT_KEY" ]; then
      echo "$HOST:$PORT ($IP) TCP=$TCP_STATUS TLS=$TLS_STATUS mTLS=$MTLS_STATUS (client_cert=$(basename $CLIENT_CERT))"
    else
      echo "$HOST:$PORT ($IP) TCP=$TCP_STATUS TLS=$TLS_STATUS mTLS=$MTLS_STATUS"
    fi
  else
    echo
    echo "=== Test de connexion TLS vers $HOST:$PORT ($IP) ==="
    echo "Résultats : TCP=$TCP_STATUS TLS=$TLS_STATUS mTLS=$MTLS_STATUS"
    [ -n "$CLIENT_CERT" ] && echo "Cert client fourni : $CLIENT_CERT (key: $CLIENT_KEY)"
    [ -n "$CA_CERT" ] && echo "CA fournie : $CA_CERT"
    echo

    if [ "$TCP_STATUS" != "OK" ]; then
      echo "❌ Connexion TCP échouée."
      rm -f "$TMP_OUT"
      return 1
    fi

    echo "✅ Connexion TCP OK"

    echo
    echo "=== Détection d'une demande de certificat client ==="
    if grep -q "Acceptable client certificate CA names" "$TMP_OUT"; then
      echo "🔒 Le serveur DEMANDE un certificat client (mTLS)."
      echo
      echo "🧾 Autorités de certification acceptées :"
      awk '/Acceptable client certificate CA names/{flag=1;next}/SSL handshake/{flag=0}flag' "$TMP_OUT" | sed '/^$/d' | sed 's/^/   • /'
    elif grep -q "SSL alert number 40" "$TMP_OUT"; then
      echo "⚠️  Le serveur a envoyé une alerte SSL (possible rejet faute de certificat client)."
    else
      echo "✅ Le serveur n’exige PAS de certificat client."
    fi

    echo
    echo "=== Détails TLS ==="
    grep -E 'Verification|Protocol|Cipher|Start Time|Expire' "$TMP_OUT" || true

    echo
    echo "=== Certificat serveur ==="
    cat "$TMP_OUT" | openssl x509 -noout -dates -subject -issuer 2>/dev/null || echo "(impossible de récupérer le certificat serveur)"

    echo
    echo "=== Vérification expiration ==="
    END_DATE=$(cat "$TMP_OUT" | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)
    if [ -n "$END_DATE" ]; then
      END_TS=$(date -d "$END_DATE" +%s 2>/dev/null)
      NOW_TS=$(date +%s)
      DAYS_LEFT=$(( (END_TS - NOW_TS) / 86400 ))
      echo "Le certificat expire dans $DAYS_LEFT jours."
      if [ $DAYS_LEFT -lt 30 ]; then
        echo "⚠️  Expiration imminente."
      else
        echo "✅ Certificat encore valide."
      fi
    else
      echo "⚠️  Impossible de déterminer la date d’expiration."
    fi
  fi

  rm -f "$TMP_OUT"

  # Codes retour :
  # 0 = tout OK
  # 1 = échec TCP
  # 2 = échec TLS (handshake)
  # 3 = mTLS requis mais aucun cert client fourni
  # 4 = cert client fourni mais handshake mTLS a échoué
  if [ "$TCP_STATUS" != "OK" ]; then return 1; fi
  if [ "$TLS_STATUS" != "OK" ]; then
    # si TLS KO et le serveur demandait mTLS et aucun cert client fourni, renvoyer 3
    if [ "$MTLS_STATUS" = "REQ" ] && { [ -z "$CLIENT_CERT" ] || [ -z "$CLIENT_KEY" ]; }; then
      return 3
    fi
    # si client fourni mais handshake échoue => 4
    if [ -n "$CLIENT_CERT" ] && [ -n "$CLIENT_KEY" ] && [ "$MTLS_STATUS" = "FAIL" ]; then
      return 4
    fi
    return 2
  fi
  # TLS ok :
  if [ "$MTLS_STATUS" = "REQ" ] && { [ -z "$CLIENT_CERT" ] || [ -z "$CLIENT_KEY" ]; }; then
    return 3
  fi
  if [ -n "$CLIENT_CERT" ] && [ -n "$CLIENT_KEY" ] && [ "$MTLS_STATUS" = "FAIL" ]; then
    return 4
  fi
  return 0
}

# ==============================
# Parsing arguments
# ==============================

TARGET=$1
DEFAULT_PORT=$2
shift 2

CLIENT_CERT=""
CLIENT_KEY=""
CA_CERT=""
VERBOSE=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cert) CLIENT_CERT=$2; shift 2 ;;
    --key) CLIENT_KEY=$2; shift 2 ;;
    --ca) CA_CERT=$2; shift 2 ;;
    --verbose) VERBOSE=1; shift ;;
    *) echo "Argument inconnu : $1"; exit 1 ;;
  esac
done

if [ -z "$TARGET" ] || [ -z "$DEFAULT_PORT" ]; then
  echo "Usage: $0 <host|file> <port par défaut> [--cert client.crt --key client.key --ca ca.crt] [--verbose]"
  exit 1
fi

# ==============================
# Si fichier → boucle
# ==============================

if [ -f "$TARGET" ]; then
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [[ "$line" =~ ^# ]] && continue

    HOST=$(echo "$line" | cut -d: -f1)
    PORT=$(echo "$line" | cut -s -d: -f2)
    [ -z "$PORT" ] && PORT="$DEFAULT_PORT"

    check_target "$HOST" "$PORT" "$CLIENT_CERT" "$CLIENT_KEY" "$CA_CERT" "$VERBOSE"
    rc=$?
    # affiche code retour si mode verbose, sinon silencieux (tu peux gérer rc comme tu veux)
    if [ $VERBOSE -eq 1 ]; then
      echo "Return code: $rc"
    fi
  done < "$TARGET"
else
  check_target "$TARGET" "$DEFAULT_PORT" "$CLIENT_CERT" "$CLIENT_KEY" "$CA_CERT" "$VERBOSE"
  exit $?
fi