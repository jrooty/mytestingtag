#!/bin/bash
# Audit complet : VS C3D + test TCP / TLS / mTLS sur les pool members
# Compatible jq F5 (pas de regex, pas de //)
# HTTP 8100, admin:
# Options :
#   --debug      → logs détaillés
#   --c3d-only   → n'affiche que les VS avec C3D=ON

set -euo pipefail

DEBUG=0
FILTER_C3D_ONLY=0

for arg in "$@"; do
  case "$arg" in
    --debug) DEBUG=1 ;;
    --c3d-only) FILTER_C3D_ONLY=1 ;;
  esac
done

# Vars mTLS optionnelles
CLIENT_CERT="client.crt"
CLIENT_KEY="client.key"
CA_FILE="ca.crt"

USE_MTLS=0
[[ -f "$CLIENT_CERT" && -f "$CLIENT_KEY" && -f "$CA_FILE" ]] && USE_MTLS=1

F5_HOST="localhost:8100"
BASE="http://$F5_HOST"
AUTH="admin:"
VS_URL="$BASE/mgmt/tm/ltm/virtual?expandSubcollections=true"
POOL_URL="$BASE/mgmt/tm/ltm/pool?expandSubcollections=true"

TMP_VS=$(mktemp)
TMP_POOL=$(mktemp)
TMP_SSL=$(mktemp)
trap 'rm -f "$TMP_VS" "$TMP_POOL" "$TMP_SSL"' EXIT

echo "[INFO] Lecture des Virtual Servers..."
curl -sS --insecure -u "$AUTH" "$VS_URL" -o "$TMP_VS"

echo "[INFO] Lecture des Pools et de leurs membres..."
curl -sS --insecure -u "$AUTH" "$POOL_URL" -o "$TMP_POOL"

printf "\n%-20s %-35s %-35s %-6s %-8s %-8s %-8s\n" \
  "PARTITION" "VS_NAME" "POOL_MEMBER" "PORT" "TCP" "TLS" "mTLS"
printf "%s\n" \
  "──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"

jq -r '
  .items[]? |
  {
    vs: .fullPath,
    pool: (if .pool == null then "-" else .pool end),
    profiles: (if .profilesReference.items == null then [] else .profilesReference.items end)
  } | @base64
' "$TMP_VS" | while read -r row; do
  _jq() { echo "$row" | base64 --decode | jq -r "$1"; }

  vs_path=$(_jq '.vs')
  vs_pool=$(_jq '.pool')
  part="${vs_path%/*}"; part="${part#/}"
  vs_name="${vs_path##*/}"

  ssl_name="-"
  c3d_status="OFF"

  profiles_json=$(_jq '.profiles')
  count=$(echo "$profiles_json" | jq 'length')

  # Recherche du profil server-ssl
  if [ "$count" -gt 0 ]; then
    for idx in $(seq 0 $((count - 1))); do
      name=$(echo "$profiles_json" | jq -r ".[$idx].name")
      link=$(echo "$profiles_json" | jq -r ".[$idx].nameReference.link")

      if [[ "$link" == *"ltm/profile/server-ssl/"* ]]; then
        ssl_name="$name"
        if [[ "$link" == http* ]]; then
          link=$(echo "$link" | sed 's#https://localhost#http://localhost:8100#g')
        else
          link="$BASE$link"
        fi
        curl -sS --insecure -u "$AUTH" -o "$TMP_SSL" "$link" || continue
        sslC3d=$(jq -r '.sslC3d' <"$TMP_SSL" 2>/dev/null || echo "")
        lower=$(echo "$sslC3d" | tr '[:upper:]' '[:lower:]')
        if [[ "$lower" == "enabled" ]]; then
          c3d_status="ON"
        fi
        (( DEBUG )) && echo "[DEBUG] VS=$vs_name profil=$ssl_name sslC3d=$sslC3d → C3D=$c3d_status"
        break
      fi
    done
  fi

  # Filtrage si --c3d-only
  if (( FILTER_C3D_ONLY )) && [[ "$c3d_status" != "ON" ]]; then
    continue
  fi

  # Récupération des membres des pools de la même partition
  jq -r --arg part "$part" '
    .items[]
    | select(.fullPath != null and (.fullPath | startswith("/" + $part + "/")))
    | .membersReference.items[]?
    | {
        addr: (if .address != null then .address
               elif .addr != null then .addr
               elif (.name|split(":")|length>0) then (.name|split(":")[0])
               else "unknown" end),
        port: (if .port != null and .port != 0 then (.port|tostring)
               elif (.name|split(":")|length>1) then (.name|split(":")[1])
               else "unknown" end)
      } | @tsv
  ' "$TMP_POOL" | while IFS=$'\t' read -r ip port; do
      tcp_res="KO"
      tls_res="KO"
      mtls_res="KO"

      # Test TCP
      if timeout 3 bash -c "echo > /dev/tcp/$ip/$port" 2>/dev/null; then
        tcp_res="OK"
        # Test TLS simple
        if timeout 5 openssl s_client -connect "$ip:$port" </dev/null 2>/dev/null | grep -q "-----BEGIN CERTIFICATE-----"; then
          tls_res="OK"
        else
          tls_res="KO"
        fi
        # Test mTLS (si fichiers présents)
        if (( USE_MTLS )); then
          if timeout 5 openssl s_client -connect "$ip:$port" \
              -cert "$CLIENT_CERT" -key "$CLIENT_KEY" -CAfile "$CA_FILE" </dev/null 2>/dev/null | grep -q "-----BEGIN CERTIFICATE-----"; then
            mtls_res="OK"
          else
            mtls_res="KO"
          fi
        fi
      else
        tcp_res="KO"
      fi

      printf "%-20s %-35s %-35s %-6s %-8s %-8s %-8s\n" \
        "$part" "$vs_name" "$ip" "$port" "$tcp_res" "$tls_res" "$mtls_res"
  done

done

echo -e "\n[INFO] Audit complet terminé."