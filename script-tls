#!/bin/bash
set -euo pipefail

# Ce script nécessite l'exécution sur un BIG-IP avec tmsh.
# Il parcourt toutes les partitions et classe chaque VS :
# - fastl4  : s'il a un profil fastL4
# - https   : s'il a un profil clientssl (front-end SSL)
# - http    : s'il a un profil http (sans clientssl)
# - other   : sinon

# Récupération en "one-line" de tous les VS, récursivement (toutes partitions)
# On force la racine "/" pour couvrir *toutes* les partitions.
mapfile -t LINES < <(tmsh -q -c 'cd /; list ltm virtual recursive one-line' 2>/dev/null || true)

# En-tête
printf "%-30s %-35s %-22s %-8s\n" "PARTITION" "VS_NAME" "DESTINATION" "TYPE"

for line in "${LINES[@]}"; do
  # Exemple de début de ligne:
  # ltm virtual /Common/vs_name { destination /Common/10.0.0.1:443 ip-protocol tcp profiles { http { } clientssl { } } ... }

  # Extraire le chemin complet du VS (/Partition/Name)
  vs_path=$(awk '{for (i=1;i<=NF;i++) if ($i=="virtual") {print $(i+1); break}}' <<<"$line")
  [[ -z "$vs_path" ]] && continue

  # Partition et nom
  part="${vs_path%/*}"; part="${part#/}"           # /Common -> Common
  vs_name="${vs_path##*/}"                         # /Common/vs -> vs

  # Destination (token "destination" + champ suivant)
  dest=$(awk '{for (i=1;i<=NF;i++) if ($i=="destination") {print $(i+1); break}}' <<<"$line")
  # Le champ destination peut être /Common/1.2.3.4:443 -> on n'affiche que l'IP:port
  if [[ "$dest" == */*:* ]]; then
    dest="${dest##*/}"
  fi

  # Extraire la sous-chaîne du bloc profiles { ... } (toute la ligne est en une seule ligne)
  # On tolère l'absence de bloc profiles.
  profiles_raw=$(sed -n 's/.*profiles { \(.*\) }.*/\1/p' <<<"$line" || true)
  profiles_lc=$(echo "${profiles_raw,,}" )  # to lowercase

  # Détection du type
  # Priorité : fastl4 > https (clientssl) > http > other
  vs_type="other"
  if grep -q 'fastl4' <<<"$profiles_lc"; then
    vs_type="fastl4"
  elif grep -q 'clientssl' <<<"$profiles_lc"; then
    vs_type="https"
  elif grep -q -w 'http' <<<"$profiles_lc"; then
    vs_type="http"
  fi

  printf "%-30s %-35s %-22s %-8s\n" "$part" "$vs_name" "${dest:-"-"}" "$vs_type"
done