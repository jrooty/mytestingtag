#!/bin/bash
# Audit complet des Virtual Servers avec expandSubcollections=true
# Détection des profils server-ssl et C3D actif
# Compatible jq sans regex (F5), un seul appel REST, mode debug optionnel

set -euo pipefail

DEBUG=0
[[ "${1:-}" == "--debug" ]] && DEBUG=1

F5_URL="http://localhost:8100/mgmt/tm/ltm/virtual?expandSubcollections=true"
AUTH="admin:"
TMP_VS=$(mktemp)
trap 'rm -f "$TMP_VS"' EXIT

echo "[INFO] Lecture des Virtual Servers (expandSubcollections=true)..."
curl -sS --insecure -u "$AUTH" "$F5_URL" -o "$TMP_VS"

# Vérifie JSON
if ! jq -e . >/dev/null 2>&1 <"$TMP_VS"; then
  echo "[ERR] Réponse non JSON. Extrait :"
  head -n 20 "$TMP_VS"
  exit 1
fi

printf "\n%-25s %-40s %-35s %-8s\n" "PARTITION" "VS_NAME" "SERVER_SSL_PROFILE" "C3D"
printf "%s\n" "──────────────────────────────────────────────────────────────────────────────────────────────"

jq -r '
  .items[]? |
  {
    vs: .fullPath,
    profiles: (.profilesReference.items // [])
  } | @base64
' "$TMP_VS" | while read -r vs_enc; do
  _jq() { echo "$vs_enc" | base64 --decode | jq -r "$1"; }

  vs_path=$(_jq '.vs')
  part="${vs_path%/*}"; part="${part#/}"
  vs_name="${vs_path##*/}"

  ssl_name="-"
  c3d_status="-"

  profiles_json=$(_jq '.profiles')

  if (( DEBUG )); then
    echo -e "\n[DEBUG] VS: $vs_path"
    echo "$profiles_json" | jq -r '.[]?.name'
  fi

  count=$(echo "$profiles_json" | jq 'length')
  if [ "$count" -gt 0 ]; then
    for idx in $(seq 0 $((count - 1))); do
      name=$(echo "$profiles_json" | jq -r ".[$idx].name // empty")
      ctx=$(echo "$profiles_json" | jq -r ".[$idx].context // empty")
      link=$(echo "$profiles_json" | jq -r ".[$idx].nameReference.link // empty" | sed 's#\.\./##g')

      if [[ "$link" == *"ltm/profile/server-ssl/"* ]]; then
        ssl_name="$name"

        if (( DEBUG )); then
          echo "[DEBUG] -> Profil server-ssl trouvé : $ssl_name (context=$ctx)"
          echo "[DEBUG] -> Lien : $link"
        fi

        # Lecture du contenu du profil déjà expandu (même JSON)
        c3d_status=$(jq -r --arg VS "$vs_path" --arg SSL "$ssl_name" '
          .items[]
          | select(.fullPath == $VS)
          | .profilesReference.items[]
          | select(.name == $SSL)
          | if ((.clientCertCA? // "") != "none" and .clientCertCA != null)
            or ((.c3dCA? // "") != "none" and .c3dCA != null)
            or ((.c3dCaCerts? // "") != "none" and .c3dCaCerts != null)
            or ((.c3d? // "") != "none" and .c3d != null)
            then "ON"
            else "OFF"
            end
        ' "$TMP_VS")

        if (( DEBUG )); then
          echo "[DEBUG] -> C3D check : $c3d_status"
        fi
        break
      fi
    done
  fi

  printf "%-25s %-40s %-35s %-8s\n" "$part" "$vs_name" "$ssl_name" "$c3d_status"
done

echo -e "\n[INFO] Audit terminé."