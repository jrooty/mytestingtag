# =========================
# MODE DIRECT --target
# =========================
if [[ -n "$TARGET" ]]; then
  IP="${TARGET%%:*}"
  PORT="${TARGET##*:}"
  [[ -z "$SNI" ]] && SNI="$IP"

  echo "[INFO] Mode direct --target : ${IP}:${PORT}"
  echo

  tcp_res="KO"; tls_res="KO"; mtls_res="KO"

  # Test TCP
  if timeout 3 bash -c "echo > /dev/tcp/$IP/$PORT" 2>/dev/null; then
    tcp_res="OK"

    # Test TLS simple
    if timeout 8 openssl s_client -connect "$IP:$PORT" -servername "$SNI" </dev/null \
        | grep -q "BEGIN CERTIFICATE"; then
      tls_res="OK"
    fi

    # Test mTLS si matériel présent
    if (( USE_MTLS )); then
      if timeout 8 openssl s_client -connect "$IP:$PORT" -servername "$SNI" \
           -cert "$CLIENT_CERT" -key "$CLIENT_KEY" -CAfile "$CA_FILE" </dev/null \
           | grep -q "BEGIN CERTIFICATE"; then
        mtls_res="OK"
      else
        mtls_res="REQ"
      fi
    fi
  fi

  # Couleurs
  GREEN="\033[32m"; RED="\033[31m"; YELLOW="\033[33m"; BOLD="\033[1m"; RESET="\033[0m"
  [[ "$tcp_res" == "OK" ]] && tcp_col="${GREEN}OK${RESET}" || tcp_col="${RED}KO${RESET}"
  [[ "$tls_res" == "OK" ]] && tls_col="${GREEN}OK${RESET}" || tls_col="${RED}KO${RESET}"
  case "$mtls_res" in
    OK) mtls_col="${GREEN}OK${RESET}" ;;
    REQ) mtls_col="${YELLOW}REQ${RESET}" ;;
    *) mtls_col="${RED}KO${RESET}" ;;
  esac

  echo -e "${BOLD}Cible:${RESET} ${IP}:${PORT}   ${BOLD}SNI:${RESET} ${SNI}"
  echo -e "${BOLD}Résultats:${RESET}  TCP=${tcp_col}  TLS=${tls_col}  mTLS=${mtls_col}"
  echo

  # ----- Détails certificat serveur -----
  if [[ "$tls_res" == "OK" ]]; then
    echo "[INFO] Détails certificat serveur :"
    if [[ -n "$SNI" ]]; then
      openssl s_client -connect "${IP}:${PORT}" -servername "${SNI}" -showcerts </dev/null \
        | awk '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/' \
        | head -n 100 \
        | openssl x509 -noout \
            -subject -issuer -dates -fingerprint -sha256 -ext subjectAltName 2>/dev/null \
        | sed 's/^/  /'
    else
      openssl s_client -connect "${IP}:${PORT}" -showcerts </dev/null \
        | awk '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/' \
        | head -n 100 \
        | openssl x509 -noout \
            -subject -issuer -dates -fingerprint -sha256 -ext subjectAltName 2>/dev/null \
        | sed 's/^/  /'
    fi
    echo
  fi

  # ----- CA acceptées par le serveur pour mTLS -----
  echo "[INFO] CA acceptées par le serveur (si fournies) :"
  if [[ -n "$SNI" ]]; then
    openssl s_client -connect "${IP}:${PORT}" -servername "${SNI}" </dev/null \
      | awk '/Acceptable client certificate CA names/{flag=1;next} flag && NF{print "  "$0} flag && /^$/{flag=0}'
  else
    openssl s_client -connect "${IP}:${PORT}" </dev/null \
      | awk '/Acceptable client certificate CA names/{flag=1;next} flag && NF{print "  "$0} flag && /^$/{flag=0}'
  fi
  echo

  # ----- Infos locales mTLS -----
  if (( USE_MTLS )); then
    echo "[INFO] Matériel client mTLS local :"
    subj_client=$(openssl x509 -in "$CLIENT_CERT" -noout -subject 2>/dev/null | sed 's/^subject= *//')
    iss_client=$(openssl x509 -in "$CLIENT_CERT" -noout -issuer  2>/dev/null | sed 's/^issuer= *//')
    subj_ca=$(openssl x509 -in "$CA_FILE"     -noout -subject 2>/dev/null | sed 's/^subject= *//')
    iss_ca=$(openssl x509 -in "$CA_FILE"      -noout -issuer  2>/dev/null | sed 's/^issuer= *//')
    echo "  Client cert (subject): ${subj_client}"
    echo "  Client cert (issuer) : ${iss_client}"
    echo "  CA locale (subject)  : ${subj_ca}"
    echo "  CA locale (issuer)   : ${iss_ca}"
    echo
  fi

  exit 0
fi