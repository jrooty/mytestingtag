#!/bin/bash
set -e

F5_USER="admin:"
F5_URL="http://localhost:8100"
TMP_AS3=$(mktemp)
TMP_POOLS=$(mktemp)

echo "[INFO] Récupération des pools via iControl..."
curl -sS --insecure -u "$F5_USER" "$F5_URL/mgmt/tm/ltm/pool" | jq -r '.items[].name' > "$TMP_POOLS"

echo "[INFO] Récupération de la déclaration AS3..."
curl -sS --insecure -u "$F5_USER" "$F5_URL/mgmt/shared/appsvcs/declare" -o "$TMP_AS3"

echo
echo "=== Corrélation des pools ==="
while read -r pool; do
    # Vérifie si la clé $pool existe quelque part dans la hiérarchie AS3
    found=$(jq -r --arg POOL "$pool" '
        def walk(f):
            . as $in
            | if type == "object" then reduce keys[] as $key ({}; . + { ($key): ($in[$key] | walk(f)) }) | f
              elif type == "array" then map(walk(f)) | f
              else f end;
        walk(.) | select(has($POOL)) | $POOL
    ' "$TMP_AS3" | head -n1)

    if [ -n "$found" ]; then
        # Cherche un VS (Service_HTTPS / Service_L4) qui référence ce pool
        vs_name=$(jq -r --arg POOL "$pool" '
            .. | objects
            | select(has("class"))
            | select(.class == "Service_HTTPS" or .class == "Service_L4")
            | select(.pool == $POOL)
            | .name // empty
        ' "$TMP_AS3" | head -n1)

        if [ -n "$vs_name" ]; then
            echo "✅ Pool '$pool' trouvé → VS associé : $vs_name"
        else
            echo "⚠️  Pool '$pool' trouvé dans AS3 (pas de VS lié)"
        fi
    else
        echo "❌ Pool '$pool' non trouvé dans la déclaration AS3"
    fi
done < "$TMP_POOLS"

rm -f "$TMP_AS3" "$TMP_POOLS"