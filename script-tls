#!/bin/bash
# Liste tous les VS (toutes partitions) et indique fastl4 / https / http
# Détection basée sur des noms standardisés de profil :
#  - fastl4 : présence d'un profil contenant "PrfFastl4"
#  - https  : présence simultanée de "PrfCSSL" et "PrfHTTP"
#  - http   : présence de "PrfHTTP" sans "PrfCSSL"
# Sinon : "other"

set -eo pipefail

# Récupère toutes les virtuals en une ligne (toutes partitions)
tmsh -q -c 'cd /; list ltm virtual recursive one-line' 2>/dev/null | while IFS= read -r line; do
  # Chemin VS (/Partition/Name)
  vs_path=$(awk '{for (i=1;i<=NF;i++) if ($i=="virtual") {print $(i+1); break}}' <<<"$line")
  [ -z "$vs_path" ] && continue
  part="${vs_path%/*}"; part="${part#/}"
  vs_name="${vs_path##*/}"

  # Destination (IP:port)
  dest=$(awk '{for (i=1;i<=NF;i++) if ($i=="destination") {print $(i+1); break}}' <<<"$line")
  [[ "$dest" == */*:* ]] && dest="${dest##*/}"

  # Extraire le bloc profiles { ... } sur la one-line
  prof_block=$(sed -n 's/.*profiles { \(.*\) }.*/\1/p' <<<"$line" || true)

  # Fallback : si le bloc n'est pas présent, on récupère les profils pour ce VS
  if [ -z "$prof_block" ]; then
    vs_prof_line=$(tmsh -q -c "list ltm virtual ${vs_path} profiles one-line" 2>/dev/null || true)
    prof_block=$(sed -n 's/.*profiles { \(.*\) }.*/\1/p' <<<"$vs_prof_line" || true)
  fi

  # Normaliser en minuscules pour un match tolérant (PrfHTTP/prfHTTP…)
  prof_lc=$(echo "$prof_block" | tr '[:upper:]' '[:lower:]')

  # Flags selon tes patterns
  has_fastl4=0; has_http=0; has_cssl=0
  [[ "$prof_lc" == *prffastl4* ]] && has_fastl4=1
  [[ "$prof_lc" == *prfhttp*   ]] && has_http=1
  [[ "$prof_lc" == *prfcssl*   ]] && has_cssl=1

  # Classement par priorité
  vs_type="other"
  if [ $has_fastl4 -eq 1 ]; then
    vs_type="fastl4"
  elif [ $has_http -eq 1 ] && [ $has_cssl -eq 1 ]; then
    vs_type="https"
  elif [ $has_http -eq 1 ] && [ $has_cssl -eq 0 ]; then
    vs_type="http"
  fi

  printf "%-28s %-40s %-24s %-8s\n" "$part" "$vs_name" "${dest:-"-"}" "$vs_type"
done