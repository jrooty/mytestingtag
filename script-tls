#!/bin/bash
set -e

F5_USER="admin:"
F5_URL="http://localhost:8100"
TMP_AS3=$(mktemp)
TMP_POOLS=$(mktemp)

echo "[INFO] Récupération des pools via iControl..."
curl -sS --insecure -u "$F5_USER" "$F5_URL/mgmt/tm/ltm/pool" | jq -r '.items[].name' > "$TMP_POOLS"

echo "[INFO] Récupération de la déclaration AS3..."
curl -sS --insecure -u "$F5_USER" "$F5_URL/mgmt/shared/appsvcs/declare" -o "$TMP_AS3"

echo
echo "=== Corrélation des pools ==="

# Parcours de tous les pools iControl
while read -r pool; do
    # Recherche d’une clé portant ce nom dans le 3e niveau (tenant > app > objets)
    found=$(jq -r --arg POOL "$pool" '
        to_entries[]?.value
        | to_entries[]
        | select(.value.class == "Application")
        | select(.value[$POOL].class == "Pool")
        | .key
    ' "$TMP_AS3" | head -n1)

    if [ -n "$found" ]; then
        # Trouver le VS (Service_HTTPS ou Service_L4) associé
        vs_name=$(jq -r --arg POOL "$pool" '
            .. | objects
            | select(has("class"))
            | select(.class == "Service_HTTPS" or .class == "Service_L4")
            | select(.pool == $POOL)
            | .name // empty
        ' "$TMP_AS3" | head -n1)

        if [ -n "$vs_name" ]; then
            echo "✅ Pool '$pool' trouvé dans l'application '$found' → VS associé : $vs_name"
        else
            echo "⚠️  Pool '$pool' trouvé dans l'application '$found' (aucun VS lié)"
        fi
    else
        echo "❌ Pool '$pool' non trouvé dans la déclaration AS3"
    fi
done < "$TMP_POOLS"

rm -f "$TMP_AS3" "$TMP_POOLS"