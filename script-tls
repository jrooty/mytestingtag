#!/bin/bash
# Audit des VS avec C3D activé → liste les pools + pool members (IP:port)
# Compatible jq minimal (F5)
# HTTP 8100, admin:
# Un seul appel expandSubcollections pour VS et Pools
# Options :
#   --debug      → logs détaillés
#   --c3d-only   → n'affiche que les VS avec C3D=ON

set -euo pipefail

DEBUG=0
FILTER_C3D_ONLY=0

for arg in "$@"; do
  case "$arg" in
    --debug) DEBUG=1 ;;
    --c3d-only) FILTER_C3D_ONLY=1 ;;
  esac
done

F5_HOST="localhost:8100"
BASE="http://$F5_HOST"
AUTH="admin:"
VS_URL="$BASE/mgmt/tm/ltm/virtual?expandSubcollections=true"
POOL_URL="$BASE/mgmt/tm/ltm/pool?expandSubcollections=true"

TMP_VS=$(mktemp)
TMP_POOL=$(mktemp)
TMP_SSL=$(mktemp)
trap 'rm -f "$TMP_VS" "$TMP_POOL" "$TMP_SSL"' EXIT

echo "[INFO] Lecture des Virtual Servers..."
curl -sS --insecure -u "$AUTH" "$VS_URL" -o "$TMP_VS"

echo "[INFO] Lecture des Pools et de leurs membres..."
curl -sS --insecure -u "$AUTH" "$POOL_URL" -o "$TMP_POOL"

printf "\n%-25s %-40s %-35s %-8s %-60s\n" \
  "PARTITION" "VS_NAME" "SERVER_SSL_PROFILE" "C3D" "POOL_MEMBERS (IP:PORT)"
printf "%s\n" \
  "──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"

# Boucle sur les VS
jq -r '
  .items[]? |
  {
    vs: .fullPath,
    pool: (if .pool == null then "-" else .pool end),
    profiles: (if .profilesReference.items == null then [] else .profilesReference.items end)
  } | @base64
' "$TMP_VS" | while read -r row; do
  _jq() { echo "$row" | base64 --decode | jq -r "$1"; }

  vs_path=$(_jq '.vs')
  vs_pool=$(_jq '.pool')
  part="${vs_path%/*}"; part="${part#/}"
  vs_name="${vs_path##*/}"

  ssl_name="-"
  c3d_status="OFF"

  profiles_json=$(_jq '.profiles')
  count=$(echo "$profiles_json" | jq 'length')

  # Recherche du profil server-ssl → lecture directe pour sslC3d
  if [ "$count" -gt 0 ]; then
    for idx in $(seq 0 $((count - 1))); do
      name=$(echo "$profiles_json" | jq -r ".[$idx].name")
      link=$(echo "$profiles_json" | jq -r ".[$idx].nameReference.link")

      if [[ "$link" == *"ltm/profile/server-ssl/"* ]]; then
        ssl_name="$name"
        # Conversion du lien pour HTTP local
        if [[ "$link" == http* ]]; then
          link=$(echo "$link" | sed 's#https://localhost#http://localhost:8100#g')
        else
          link="$BASE$link"
        fi
        curl -sS --insecure -u "$AUTH" -o "$TMP_SSL" "$link" || continue
        sslC3d=$(jq -r '.sslC3d // empty' <"$TMP_SSL")
        lower=$(echo "$sslC3d" | tr '[:upper:]' '[:lower:]')
        if [[ "$lower" == "enabled" ]]; then
          c3d_status="ON"
        fi
        (( DEBUG )) && echo "[DEBUG] VS=$vs_name profil=$ssl_name sslC3d=$sslC3d → C3D=$c3d_status"
        break
      fi
    done
  fi

  # Filtrage si --c3d-only activé
  if (( FILTER_C3D_ONLY )) && [[ "$c3d_status" != "ON" ]]; then
    continue
  fi

  # Recherche des pools dans la même partition + leurs membres
  pools_json=$(jq -r --arg part "$part" '
    .items[]
    | select(.fullPath != null and (.fullPath | startswith("/" + $part + "/")))
    | {pool: .name, members: (if .membersReference.items == null then [] else .membersReference.items end)}
    | @base64
  ' "$TMP_POOL")

  pool_members_display=""
  while read -r pool_row; do
    [ -z "$pool_row" ] && continue
    _p() { echo "$pool_row" | base64 --decode | jq -r "$1"; }
    pool_name=$(_p '.pool')

    # Construction IP:port (fallback sur name)
    members=$(_p '.members | map(
      if (.address != null and .address != "")
        then (.address + ":" + (.port|tostring))
        elif (.addr != null and .addr != "")
        then (.addr + ":" + (.port|tostring))
        else .name
      end
    ) | join(" ")')

    if [ -z "$members" ]; then
      members="(aucun membre)"
    fi
    pool_members_display+="[$pool_name: $members] "
  done <<< "$pools_json"

  [ -z "$pool_members_display" ] && pool_members_display="(aucun pool)"
  pool_members_display=$(echo "$pool_members_display" | sed 's/ *$//')

  printf "%-25s %-40s %-35s %-8s %-60s\n" \
    "$part" "$vs_name" "$ssl_name" "$c3d_status" "$pool_members_display"

done

echo -e "\n[INFO] Audit terminé."