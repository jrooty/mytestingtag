#!/bin/bash
# Audit des Virtual Servers avec expandSubcollections=true
# Détecte profils server-ssl + C3D actif, via un SEUL appel iControl REST.
# Connexion locale (HTTP 8100), admin: sans mot de passe.

set -euo pipefail

F5_URL="http://localhost:8100/mgmt/tm/ltm/virtual?expandSubcollections=true"
AUTH="admin:"
TMP_VS=$(mktemp)
trap 'rm -f "$TMP_VS"' EXIT

echo "[INFO] Récupération de la liste complète des VS (expandSubcollections=true)..."
curl -sS --insecure -u "$AUTH" "$F5_URL" -o "$TMP_VS"

# Vérifie JSON
if ! jq -e . >/dev/null 2>&1 <"$TMP_VS"; then
  echo "[ERR] Réponse non valide JSON, extrait :"
  head -n 20 "$TMP_VS"
  exit 1
fi

printf "%-25s %-40s %-35s %-8s\n" "PARTITION" "VS_NAME" "SERVER_SSL_PROFILE" "C3D"

jq -r '
  .items[]? |
  {
    vs: .fullPath,
    profiles: (.profilesReference.items // [] |
                map(select(.context == "serverside" and (.name | test("server-ssl";"i"))))
               )
  } | @base64
' "$TMP_VS" | while read -r vs_enc; do
  _jq() { echo "$vs_enc" | base64 --decode | jq -r "$1"; }

  vs_path=$(_jq '.vs')
  part="${vs_path%/*}"; part="${part#/}"
  vs_name="${vs_path##*/}"

  # Profil serveur SSL (si présent)
  ssl_name=$(_jq '.profiles[0].name // "-"')
  c3d_status="-"

  if [[ "$ssl_name" != "-" ]]; then
    # Cherche les attributs C3D directement dans le JSON expandu
    c3d_status=$(jq -r --arg VS "$vs_path" '
      .items[]
      | select(.fullPath == $VS)
      | .profilesReference.items[]
      | select(.context == "serverside" and (.name | test("server-ssl";"i")))
      | if ((.clientCertCA? // "") != "none" and .clientCertCA != null)
          or ((.c3dCA? // "") != "none" and .c3dCA != null)
          or ((.c3dCaCerts? // "") != "none" and .c3dCaCerts != null)
          or ((.c3d? // "") != "none" and .c3d != null)
        then "ON"
        else "OFF"
        end
    ' "$TMP_VS")
  fi

  printf "%-25s %-40s %-35s %-8s\n" "$part" "$vs_name" "$ssl_name" "$c3d_status"
done