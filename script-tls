#!/bin/bash
set -euo pipefail

F5_URL="http://localhost:8100"
TMP_AS3=$(mktemp)

# 1️⃣ Récupération de la déclaration AS3 locale (pas d'authent)
curl -sS --insecure "$F5_URL/mgmt/shared/appsvcs/declare" -o "$TMP_AS3"

# 2️⃣ Parcours du JSON pour lister les VS
jq -r '
  to_entries[] as $t
  | select($t.value | type=="object")
  | $t.key as $tenant
  | $t.value
  | to_entries[] as $a
  | select($a.value | type=="object" and ($a.value.class == "Application"))
  | $a.key as $app
  | $a.value
  | to_entries[]
  | select(.value | type=="object" and (.value.class == "Service_HTTP" or .value.class == "Service_HTTPS" or .value.class == "Service_L4"))
  | .key as $vs
  | .value as $svc
  | "\($tenant)/\($app) VS=\($vs) type=\($svc.class) vip=\(($svc.virtualAddresses? // [])|join(\",\")) port=\($svc.virtualPort? // \"\") pool=\($svc.pool? // \"\")"
' "$TMP_AS3"

rm -f "$TMP_AS3"