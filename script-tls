  # Recherche du profil server-ssl et champ sslC3d
  count=$(echo "$profiles_json" | jq 'length')
  if [ "$count" -gt 0 ]; then
    for idx in $(seq 0 $((count - 1))); do
      name=$(echo "$profiles_json" | jq -r ".[$idx].name")
      link=$(echo "$profiles_json" | jq -r ".[$idx].nameReference.link")
      if [[ "$link" == *"ltm/profile/server-ssl/"* ]]; then
        ssl_name="$name"

        # Extraction multi-champs (tous optionnels)
        sslC3d=$(echo "$profiles_json" | jq -r ".[$idx].sslC3d // empty")
        sslC3dMode=$(echo "$profiles_json" | jq -r ".[$idx].sslC3dMode // empty")
        sslC3dCa=$(echo "$profiles_json" | jq -r ".[$idx].sslC3dCaCert // empty")
        sslC3dKey=$(echo "$profiles_json" | jq -r ".[$idx].sslC3dKey // empty")
        sslC3dChain=$(echo "$profiles_json" | jq -r ".[$idx].sslC3dChain // empty")

        # Normalisation en minuscules
        lowerC3d=$(echo "$sslC3d" | tr '[:upper:]' '[:lower:]')
        lowerMode=$(echo "$sslC3dMode" | tr '[:upper:]' '[:lower:]')

        # C3D activé uniquement si un des critères est vrai
        if [[ "$lowerC3d" == "enabled" ]] \
          || [[ "$lowerMode" == "enabled" || "$lowerMode" == "require" ]] \
          || [[ -n "$sslC3dCa" && "$sslC3dCa" != "none" ]] \
          || [[ -n "$sslC3dKey" && "$sslC3dKey" != "none" ]] \
          || [[ -n "$sslC3dChain" && "$sslC3dChain" != "none" ]]; then
          c3d_status="ON"
        else
          c3d_status="OFF"
        fi

        if (( DEBUG )); then
          echo "[DEBUG] Profil=$ssl_name sslC3d=$sslC3d sslC3dMode=$sslC3dMode sslC3dCa=$sslC3dCa sslC3dKey=$sslC3dKey sslC3dChain=$sslC3dChain → C3D=$c3d_status"
        fi
        break
      fi
    done
  fi