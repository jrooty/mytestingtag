#!/bin/bash
#
# Script de test de connectivité TCP / TLS / mTLS
# Auteur : ChatGPT (GPT-5)
# Version : finale + couleurs
#
# Usage :
#   ./tls_tester.sh host port [--verbose]
#   ./tls_tester.sh -f fichier_cibles.txt [--verbose]
#
# Format du fichier :
#   host port
#   host2 port2
#

# ------------------------------
# Variables configurables
# ------------------------------
CLIENT_CERT=""
CLIENT_KEY=""
CA_FILE=""
SLEEP_BETWEEN_TESTS_MS=200   # Délai entre tests multiples (en millisecondes)
TIMEOUT=5
VERBOSE=0

# Couleurs
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ------------------------------
# Fonctions
# ------------------------------

usage() {
  echo "Usage:"
  echo "  $0 host port [--verbose]"
  echo "  $0 -f fichier_cibles.txt [--verbose]"
  echo ""
  echo "Options:"
  echo "  --client-cert=FILE   Certificat client (optionnel)"
  echo "  --client-key=FILE    Clé privée client (optionnel)"
  echo "  --ca=FILE            CA pour la vérification TLS"
  echo "  --sleep-ms=NUM       Délai entre tests (ms, défaut 200)"
  echo "  --timeout=NUM        Timeout en secondes (défaut 5)"
  echo "  --verbose            Mode verbeux"
  exit 1
}

sleep_ms() {
  local ms="$1"
  sleep "$(awk "BEGIN {printf \"%.3f\", $ms/1000}")"
}

colorize_status() {
  local status="$1"
  case "$status" in
    OK) echo -e "${GREEN}${status}${NC}" ;;
    KO|FAIL) echo -e "${RED}${status}${NC}" ;;
    REQ) echo -e "${YELLOW}${status}${NC}" ;;
    *) echo "$status" ;;
  esac
}

test_server() {
  local HOST="$1"
  local PORT="$2"
  local IP
  IP=$(getent ahosts "$HOST" | awk '{print $1; exit}')
  local TMP_OUT
  TMP_OUT=$(mktemp)
  local TCP_STATUS="KO"
  local TLS_STATUS="KO"
  local MTLS_STATUS="N/A"

  # --- Test TCP ---
  timeout "$TIMEOUT" bash -c "cat < /dev/null > /dev/tcp/$HOST/$PORT" 2>/dev/null
  if [ $? -eq 0 ]; then
    TCP_STATUS="OK"
  fi

  # --- Test TLS ---
  timeout "$TIMEOUT" openssl s_client -connect "${HOST}:${PORT}" -servername "$HOST" -CAfile "$CA_FILE" </dev/null >"$TMP_OUT" 2>&1
  if [ -s "$TMP_OUT" ] && (grep -q 'Cipher is ' "$TMP_OUT" || grep -q 'BEGIN CERTIFICATE' "$TMP_OUT"); then
    TLS_STATUS="OK"
  else
    TLS_STATUS="KO"
  fi

  # --- Test mTLS (si cert fourni) ---
  if [ -n "$CLIENT_CERT" ] && [ -n "$CLIENT_KEY" ]; then
    local TMP_MTLS
    TMP_MTLS=$(mktemp)
    timeout "$TIMEOUT" openssl s_client -connect "${HOST}:${PORT}" \
      -cert "$CLIENT_CERT" -key "$CLIENT_KEY" -CAfile "$CA_FILE" \
      -servername "$HOST" </dev/null >"$TMP_MTLS" 2>&1

    if grep -q "Client Certificate Types" "$TMP_OUT" && ! grep -q "Verify return code: 0 (ok)" "$TMP_MTLS"; then
      MTLS_STATUS="REQ"
    elif grep -q "Verify return code: 0 (ok)" "$TMP_MTLS"; then
      MTLS_STATUS="OK"
    else
      MTLS_STATUS="FAIL"
    fi
    rm -f "$TMP_MTLS"
  fi

  # --- Préfixe ---
  local PREFIX=""
  if [ "$TCP_STATUS" != "OK" ] || [ "$TLS_STATUS" != "OK" ] || [ "$MTLS_STATUS" = "FAIL" ]; then
    PREFIX="[${RED}ERR${NC}] "
  elif [ "$MTLS_STATUS" = "REQ" ]; then
    PREFIX="[${YELLOW}WARN${NC}] "
  fi

  # --- Affichage ---
  local TCP_C=$(colorize_status "$TCP_STATUS")
  local TLS_C=$(colorize_status "$TLS_STATUS")
  local MTLS_C=$(colorize_status "$MTLS_STATUS")

  if [ "$VERBOSE" -eq 1 ]; then
    echo -e "===== Test de ${YELLOW}${HOST}:${PORT}${NC} (${IP}) ====="
    echo -e "TCP : $TCP_C"
    echo -e "TLS : $TLS_C"
    echo -e "mTLS : $MTLS_C"
    echo -e "${PREFIX}Résultat synthétique : TCP=${TCP_C} TLS=${TLS_C} mTLS=${MTLS_C}"
    echo -e "--------------------------------------"
  else
    echo -e "${PREFIX}${HOST}:${PORT} (${IP}) TCP=${TCP_C} TLS=${TLS_C} mTLS=${MTLS_C}"
  fi

  rm -f "$TMP_OUT"
}

# ------------------------------
# Parsing arguments
# ------------------------------
if [ $# -lt 2 ]; then
  usage
fi

if [ "$1" = "-f" ]; then
  FILE="$2"
  shift 2
else
  HOST="$1"
  PORT="$2"
  shift 2
fi

# Options supplémentaires
while [ $# -gt 0 ]; do
  case "$1" in
    --verbose) VERBOSE=1 ;;
    --client-cert=*) CLIENT_CERT="${1#*=}" ;;
    --client-key=*) CLIENT_KEY="${1#*=}" ;;
    --ca=*) CA_FILE="${1#*=}" ;;
    --sleep-ms=*) SLEEP_BETWEEN_TESTS_MS="${1#*=}" ;;
    --timeout=*) TIMEOUT="${1#*=}" ;;
    *) echo "Option inconnue : $1" && usage ;;
  esac
  shift
done

# ------------------------------
# Exécution
# ------------------------------
if [ -n "$FILE" ]; then
  while read -r host port; do
    [[ -z "$host" || "$host" =~ ^# ]] && continue
    test_server "$host" "$port"
    sleep_ms "$SLEEP_BETWEEN_TESTS_MS"
  done < "$FILE"
else
  test_server "$HOST" "$PORT"
fi