  # ------------------------------
  # Affichage condensé ou verbose
  # ------------------------------
  if [ "$VERBOSE" -eq 0 ]; then
    PREFIX=""

    # Priorité ERR > WARN
    if [ "$TCP_STATUS" = "KO" ] || [ "$TLS_STATUS" = "KO" ] || [ "$MTLS_STATUS" = "FAIL" ]; then
      PREFIX="[ERR] "
    elif [ "$MTLS_STATUS" = "REQ" ]; then
      PREFIX="[WARN] "
    fi

    if [ -n "$CLIENT_CERT" ] && [ -n "$CLIENT_KEY" ]; then
      echo "${PREFIX}${HOST}:${PORT} (${IP}) TCP=${TCP_STATUS} TLS=${TLS_STATUS} mTLS=${MTLS_STATUS} (client_cert=$(basename "$CLIENT_CERT"))"
    else
      echo "${PREFIX}${HOST}:${PORT} (${IP}) TCP=${TCP_STATUS} TLS=${TLS_STATUS} mTLS=${MTLS_STATUS}"
    fi
  else
    # verbose inchangé
    ...
  fi