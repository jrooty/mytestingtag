#!/bin/bash
set -e
TMP_POOLS=$(mktemp)
TMP_AS3=$(mktemp)

# 1️⃣ Récupérer tous les pools
curl -sS --insecure -u admin: http://localhost:8100/mgmt/tm/ltm/pool?expandSubcollections=true -o "$TMP_POOLS"

# 2️⃣ Lister pool et membres
jq -r '.items? // [] | .[] | "\(.name) \(.membersReference.link // "")"' "$TMP_POOLS" > pools_list.txt

echo "Pools et pool members récupérés via iControl REST :"
cat pools_list.txt

# 3️⃣ Récupérer déclaration AS3
curl -sS --insecure -u admin: http://localhost:8100/mgmt/shared/appsvcs/declare -o "$TMP_AS3"

# 4️⃣ Corréler pool → VS via AS3
echo
echo "Corrélation Pool → VS via AS3 :"
while read -r line; do
    POOL_NAME=$(echo "$line" | awk '{print $1}')
    # Cherche un VS qui référence ce pool
    VS_NAME=$(jq -r --arg p "$POOL_NAME" '.. | objects | select(.class=="Pool" and .name==$p) | path(..) | .[-2] // empty' "$TMP_AS3")
    [ -z "$VS_NAME" ] && VS_NAME="(VS non trouvé)"
    echo "Pool=${POOL_NAME} VS=${VS_NAME}"
done < pools_list.txt

rm -f "$TMP_POOLS" "$TMP_AS3"