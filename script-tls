#!/bin/bash
# Audit des Virtual Servers avec C3D actif et leurs pools dans la même partition
# 1 appel expandSubcollections pour les VS
# 1 appel expandSubcollections pour les pools
# HTTP (port 8100), admin:, compatible jq sans regex
# Option --debug pour inspection détaillée

set -euo pipefail

DEBUG=0
[[ "${1:-}" == "--debug" ]] && DEBUG=1

# --- Connexion locale F5 ---
F5_HOST="localhost:8100"
BASE="http://$F5_HOST"
AUTH="admin:"

VS_URL="$BASE/mgmt/tm/ltm/virtual?expandSubcollections=true"
POOL_URL="$BASE/mgmt/tm/ltm/pool?expandSubcollections=true"

TMP_VS=$(mktemp)
TMP_POOL=$(mktemp)
trap 'rm -f "$TMP_VS" "$TMP_POOL"' EXIT

echo "[INFO] Lecture des Virtual Servers..."
curl -sS --insecure -u "$AUTH" "$VS_URL" -o "$TMP_VS"

echo "[INFO] Lecture des Pools..."
curl -sS --insecure -u "$AUTH" "$POOL_URL" -o "$TMP_POOL"

# Vérifie JSON
if ! jq -e . >/dev/null 2>&1 <"$TMP_VS"; then
  echo "[ERR] Réponse VS non JSON. Extrait :"
  head -n 20 "$TMP_VS"
  exit 1
fi
if ! jq -e . >/dev/null 2>&1 <"$TMP_POOL"; then
  echo "[ERR] Réponse Pools non JSON. Extrait :"
  head -n 20 "$TMP_POOL"
  exit 1
fi

printf "\n%-25s %-40s %-35s %-8s %-40s\n" "PARTITION" "VS_NAME" "SERVER_SSL_PROFILE" "C3D" "POOL_ASSOCIÉS"
printf "%s\n" "────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"

# --- Boucle sur tous les VS ---
jq -r '
  .items[]? |
  {
    vs: .fullPath,
    pool: .pool // "-",
    profiles: (.profilesReference.items // [])
  } | @base64
' "$TMP_VS" | while read -r row; do
  _jq() { echo "$row" | base64 --decode | jq -r "$1"; }

  vs_path=$(_jq '.vs')
  vs_pool=$(_jq '.pool')
  part="${vs_path%/*}"; part="${part#/}"
  vs_name="${vs_path##*/}"

  ssl_name="-"
  c3d_status="OFF"

  profiles_json=$(_jq '.profiles')

  # Recherche du profil server-ssl
  count=$(echo "$profiles_json" | jq 'length')
  if [ "$count" -gt 0 ]; then
    for idx in $(seq 0 $((count - 1))); do
      name=$(echo "$profiles_json" | jq -r ".[$idx].name // empty")
      link=$(echo "$profiles_json" | jq -r ".[$idx].nameReference.link // empty" | sed 's#\.\./##g')
      if [[ "$link" == *"ltm/profile/server-ssl/"* ]]; then
        ssl_name="$name"
        # Lire le champ sslC3d directement s'il est présent dans expandSubcollections
        raw=$(echo "$profiles_json" | jq -r ".[$idx].sslC3d // empty")
        lower=$(echo "$raw" | tr '[:upper:]' '[:lower:]')
        if [[ -n "$raw" && "$lower" != "disabled" && "$lower" != "none" ]]; then
          c3d_status="ON"
        fi
        break
      fi
    done
  fi

  # Si C3D activé → recherche des pools de la même partition
  pools_in_part="-"
  if [ "$c3d_status" = "ON" ]; then
    pools_in_part=$(jq -r --arg part "$part" '
      .items[]? | select(.fullPath | startswith("/" + $part + "/")) | .name
    ' "$TMP_POOL" | xargs)
    [ -z "$pools_in_part" ] && pools_in_part="(aucun)"
  fi

  printf "%-25s %-40s %-35s %-8s %-40s\n" \
    "$part" "$vs_name" "$ssl_name" "$c3d_status" "$pools_in_part"

  if (( DEBUG )); then
    echo "[DEBUG] VS=$vs_path pool=$vs_pool ssl=$ssl_name C3D=$c3d_status"
    echo "[DEBUG] Pools mêmes partition: $pools_in_part"
  fi
done

echo -e "\n[INFO] Audit terminé."