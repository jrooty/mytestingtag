#!/bin/bash
# Audit VS + tests TCP/TLS/mTLS + mode direct
# Compatible F5 iControl REST localhost:8100 admin:
# Version finale stable (mode normal + mode --target + affichage complet certs)

set -euo pipefail

DEBUG=0
ALL_VS=0
SLEEP_MS=200
TARGET=""
SNI=""

# ---------- Parsing options ----------
while (( $# )); do
  case "$1" in
    --debug) DEBUG=1; shift ;;
    --all-vs) ALL_VS=1; shift ;;
    --sleep-ms=*) SLEEP_MS="${1#*=}"; shift ;;
    --sleep-ms) shift; SLEEP_MS="${1:-200}"; shift || true ;;
    --target=*) TARGET="${1#*=}"; shift ;;
    --target) shift; TARGET="${1:-}"; if [[ -n "${2-}" && "${2:0:2}" != "--" && -z "$TARGET" ]]; then TARGET="$2"; shift; fi ;;
    --sni=*) SNI="${1#*=}"; shift ;;
    --sni) shift; SNI="${1:-}"; if [[ -n "${2-}" && "${2:0:2}" != "--" && -z "$SNI" ]]; then SNI="$2"; shift; fi ;;
    *) break ;;
  esac
done

SLEEP_SEC=$(awk "BEGIN { printf \"%.3f\", ${SLEEP_MS} / 1000 }")

CLIENT_CERT="client.crt"
CLIENT_KEY="client.key"
CA_FILE="ca.crt"
USE_MTLS=0
[[ -f "$CLIENT_CERT" && -f "$CLIENT_KEY" && -f "$CA_FILE" ]] && USE_MTLS=1

# ---------- Fonctions ----------
extract_server_cert_details() {
  local ip="$1" port="$2" sni_host="$3"
  local cmd="openssl s_client -connect ${ip}:${port} -showcerts </dev/null 2>/dev/null"
  [[ -n "$sni_host" ]] && cmd="openssl s_client -connect ${ip}:${port} -servername ${sni_host} -showcerts </dev/null 2>/dev/null"

  eval "$cmd" \
    | awk '/-----BEGIN CERTIFICATE-----/{p=1} p{print} /-----END CERTIFICATE-----/{exit}' \
    | openssl x509 -noout -subject -issuer -dates -fingerprint -sha256 -ext subjectAltName 2>/dev/null
}

list_server_acceptable_cas() {
  local ip="$1" port="$2" sni_host="$3"
  local cmd="openssl s_client -connect ${ip}:${port} </dev/null 2>/dev/null"
  [[ -n "$sni_host" ]] && cmd="openssl s_client -connect ${ip}:${port} -servername ${sni_host} </dev/null 2>/dev/null"
  eval "$cmd" | awk '/Acceptable client certificate CA names/{flag=1;next} flag && NF{print} flag && /^$/{flag=0}'
}

# =========================
# MODE DIRECT --target
# =========================
if [[ -n "$TARGET" ]]; then
  IP="${TARGET%%:*}"
  PORT="${TARGET##*:}"
  [[ -z "$SNI" ]] && SNI="$IP"

  echo "[INFO] Mode direct --target détecté : ${IP}:${PORT}"
  echo "[INFO] Délai inter-tests (ignoré en mode direct) : ${SLEEP_MS} ms"
  echo

  tcp_res="KO"; tls_res="KO"; mtls_res="KO"

  if timeout 3 bash -c "echo > /dev/tcp/$IP/$PORT" 2>/dev/null; then
    tcp_res="OK"
    if timeout 8 openssl s_client -connect "$IP:$PORT" -servername "$SNI" </dev/null 2>/dev/null | grep "BEGIN.CERTIFICATE" >/dev/null 2>&1; then
      tls_res="OK"
    fi
    if (( USE_MTLS )); then
      if timeout 8 openssl s_client -connect "$IP:$PORT" -servername "$SNI" \
           -cert "$CLIENT_CERT" -key "$CLIENT_KEY" -CAfile "$CA_FILE" </dev/null 2>/dev/null \
           | grep "BEGIN.CERTIFICATE" >/dev/null 2>&1; then
        mtls_res="OK"
      else
        mtls_res="REQ"
      fi
    fi
  fi

  GREEN="\033[32m"; RED="\033[31m"; YELLOW="\033[33m"; BOLD="\033[1m"; RESET="\033[0m"
  [[ "$tcp_res" == "OK" ]] && tcp_col="${GREEN}OK${RESET}" || tcp_col="${RED}KO${RESET}"
  [[ "$tls_res" == "OK" ]] && tls_col="${GREEN}OK${RESET}" || tls_col="${RED}KO${RESET}"
  case "$mtls_res" in
    OK) mtls_col="${GREEN}OK${RESET}" ;;
    REQ) mtls_col="${YELLOW}REQ${RESET}" ;;
    *) mtls_col="${RED}KO${RESET}" ;;
  esac

  echo -e "${BOLD}Cible:${RESET} ${IP}:${PORT}   ${BOLD}SNI:${RESET} ${SNI}"
  echo -e "${BOLD}Résultats:${RESET}  TCP=${tcp_col}  TLS=${tls_col}  mTLS=${mtls_col}"
  echo

  if [[ "$tls_res" == "OK" ]]; then
    echo "[INFO] Détails certificat serveur :"
    extract_server_cert_details "$IP" "$PORT" "$SNI" | sed 's/^/  /'
    echo
  fi

  if (( USE_MTLS )); then
    echo "[INFO] Matériel client mTLS local :"
    echo "  Client cert (subject): $(openssl x509 -in "$CLIENT_CERT" -noout -subject 2>/dev/null | sed 's/^subject= *//')"
    echo "  Client cert (issuer) : $(openssl x509 -in "$CLIENT_CERT" -noout -issuer  2>/dev/null | sed 's/^issuer= *//')"
    echo "  CA locale (subject)  : $(openssl x509 -in "$CA_FILE"     -noout -subject 2>/dev/null | sed 's/^subject= *//')"
    echo "  CA locale (issuer)   : $(openssl x509 -in "$CA_FILE"     -noout -issuer  2>/dev/null | sed 's/^issuer= *//')"
    echo
    echo "[INFO] (Best effort) CA acceptées par le serveur pour le client cert :"
    cas=$(list_server_acceptable_cas "$IP" "$PORT" "$SNI")
    if [[ -n "$cas" ]]; then
      echo "$cas" | sed 's/^/  /'
    else
      echo "  (non disponible ou non fourni par le serveur)"
    fi
    echo
  else
    echo "[INFO] mTLS non activé localement (fichiers manquants : $CLIENT_CERT, $CLIENT_KEY, $CA_FILE)."
  fi

  exit 0
fi

# =========================
# MODE NORMAL F5
# =========================
F5_HOST="localhost:8100"
BASE="http://$F5_HOST"
AUTH="admin:"
VS_URL="$BASE/mgmt/tm/ltm/virtual?expandSubcollections=true"
POOL_URL="$BASE/mgmt/tm/ltm/pool?expandSubcollections=true"

TMP_VS=$(mktemp)
TMP_POOL=$(mktemp)
TMP_SSL=$(mktemp)
trap 'rm -f "$TMP_VS" "$TMP_POOL" "$TMP_SSL"' EXIT

curl -sS --insecure -u "$AUTH" "$VS_URL" -o "$TMP_VS"
total_vs=$(jq -r '.items | length' "$TMP_VS" 2>/dev/null || echo 0)
total_ssl=$(jq -r '.items[].profilesReference.items[].nameReference.link?' "$TMP_VS" 2>/dev/null | grep -c "ltm/profile/server-ssl/" || true)

echo -e "\n[INFO] Nombre total de Virtual Servers : ${total_vs}"
echo -e "[INFO] Nombre de Virtual Servers avec profil server-ssl : ${total_ssl}"
echo -e "[INFO] Délai entre tests de membres : ${SLEEP_MS} ms"
if (( ALL_VS )); then
  echo -e "[INFO] Mode sélectionné : Tous les Virtual Servers (--all-vs)"
else
  echo -e "[INFO] Mode sélectionné : Seulement les VS avec C3D activé (par défaut)"
fi
echo

{
curl -sS --insecure -u "$AUTH" "$POOL_URL" -o "$TMP_POOL"

jq -r '
  .items[]? |
  {
    vs: .fullPath,
    pool: (if .pool == null then "-" else .pool end),
    profiles: (if .profilesReference.items == null then [] else .profilesReference.items end)
  } | @base64
' "$TMP_VS" | while read -r row; do
  _jq() { echo "$row" | base64 --decode | jq -r "$1"; }

  vs_path=$(_jq '.vs')
  part="${vs_path%/*}"; part="${part#/}"
  vs_name="${vs_path##*/}"

  ssl_name="-"
  c3d_status="OFF"
  profiles_json=$(_jq '.profiles')
  count=$(echo "$profiles_json" | jq 'length')

  if [ "$count" -gt 0 ]; then
    for idx in $(seq 0 $((count - 1))); do
      link=$(echo "$profiles_json" | jq -r ".[$idx].nameReference.link")
      if [[ "$link" == *"ltm/profile/server-ssl/"* ]]; then
        [[ "$link" == http* ]] || link="$BASE$link"
        link=$(echo "$link" | sed 's#https://localhost#http://localhost:8100#g')
        curl -sS --insecure -u "$AUTH" -o "$TMP_SSL" "$link" 2>/dev/null || continue
        sslC3d=$(jq -r '.sslC3d' <"$TMP_SSL" 2>/dev/null || echo "")
        [[ "${sslC3d,,}" == "enabled" ]] && c3d_status="ON"
        break
      fi
    done
  fi

  if (( !ALL_VS )) && [[ "$c3d_status" != "ON" ]]; then
    continue
  fi

  echo "#VS# ${part} ${vs_name} ${c3d_status}"

  jq -r --arg part "$part" '
    .items[]
    | select(.fullPath != null and (.fullPath | startswith("/" + $part + "/")))
    | .membersReference.items[]?
    | [
        (if .address != null then .address
         elif .addr != null then .addr
         else (.name|split(":")[0]) end),
        (if .port != null and .port != 0 then (.port|tostring)
         elif (.name|split(":")|length>1) then (.name|split(":")[1])
         else "unknown" end)
      ] | join("\t")
  ' "$TMP_POOL" | while IFS=$'\t' read -r ip port; do
      [ -z "$ip" ] && continue
      tcp_res="KO"; tls_res="KO"; mtls_res="KO"

      if timeout 3 bash -c "echo > /dev/tcp/$ip/$port" 2>/dev/null; then
        tcp_res="OK"
        if timeout 8 openssl s_client -connect "$ip:$port" </dev/null 2>/dev/null | grep "BEGIN.CERTIFICATE" >/dev/null 2>&1; then
          tls_res="OK"
        fi
        if (( USE_MTLS )); then
          if timeout 8 openssl s_client -connect "$ip:$port" \
              -cert "$CLIENT_CERT" -key "$CLIENT_KEY" -CAfile "$CA_FILE" </dev/null 2>/dev/null | grep "BEGIN.CERTIFICATE" >/dev/null 2>&1; then
            mtls_res="OK"
          else
            mtls_res="REQ"
          fi
        fi
      fi

      echo "${part} ${vs_name} ${ip} ${port} ${tcp_res} ${tls_res} ${mtls_res}"
      sleep "$SLEEP_SEC"
  done
done
} | awk '
BEGIN {
  red="\033[31m"; green="\033[32m"; yellow="\033[33m"; bold="\033[1m"; reset="\033[0m"
  vsnum=0
}
/^#VS#/ {
  vsnum++; split($0,a," "); part=a[2]; vs=a[3]; c3d=a[4];
  printf("\n%s#%d%s Partition: %s  |  VS: %s  |  C3D: %s\n", bold, vsnum, reset, part, vs, c3d);
  next
}
{
  part=$1; vs=$2; ip=$3; port=$4; tcp=$5; tls=$6; mtls=$7;
  if (tcp=="OK") tcp=green tcp reset; else tcp=red tcp reset;
  if (tls=="OK") tls=green tls reset; else tls=red tls reset;
  if (mtls=="OK") mtls=green mtls reset;
  else if (mtls=="REQ") mtls=yellow mtls reset;
  else mtls=red mtls reset;
  printf("    %s:%s   TCP=%s   TLS=%s   mTLS=%s\n", ip, port, tcp, tls, mtls);
}
END { print "\n[INFO] Audit complet terminé." }'