#!/bin/bash
set -e
TMP_POOLS=$(mktemp)
TMP_AS3=$(mktemp)

# 1️⃣ Récupérer tous les pools via iControl REST
curl -sS --insecure -u admin: http://localhost:8100/mgmt/tm/ltm/pool -o "$TMP_POOLS"

# 2️⃣ Extraire les noms des pools iControl
jq -r '.items? // [] | .[] | .name' "$TMP_POOLS" > pools_list.txt

# 3️⃣ Récupérer la déclaration AS3
curl -sS --insecure -u admin: http://localhost:8100/mgmt/shared/appsvcs/declare -o "$TMP_AS3"

# 4️⃣ Extraire toutes les clés de type "Pool" (avec leur nom complet tenant/app/pool)
jq -r '
  def walk(f):
    . as $in | if type == "object" then
      reduce keys_unsorted[] as $key ({}; . + { ($key): ($in[$key] | walk(f)) }) | f
    elif type == "array" then map(walk(f)) | f
    else f
    end;

  walk(if (type=="object" and .class?=="Pool") then
    (path(.) | map(tostring) | join("/"))
  else empty end)
' "$TMP_AS3" | grep -v '^\s*$' | sort -u > as3_pools.txt

echo "Matching pools iControl → AS3 :"
while read -r POOL_NAME; do
    if grep -q "/${POOL_NAME}$" as3_pools.txt; then
        echo "Pool=${POOL_NAME} AS3_FOUND=OK"
    else
        echo "Pool=${POOL_NAME} AS3_FOUND=KO"
    fi
done < pools_list.txt

rm -f "$TMP_POOLS" "$TMP_AS3"