#!/bin/bash
IPPORT="$1"
SNI="$2"
[[ -z "$SNI" ]] && SNI="${IPPORT%%:*}"

TMP=$(mktemp)
CERT=$(mktemp)
trap 'rm -f "$TMP" "$CERT"' EXIT

echo "[INFO] Connexion à $IPPORT (SNI=$SNI)"
openssl s_client -connect "$IPPORT" -servername "$SNI" -showcerts </dev/null >"$TMP" 2>&1

awk '/-----BEGIN CERTIFICATE-----/{p=1} p{print} /-----END CERTIFICATE-----/{exit}' "$TMP" > "$CERT"

if grep -q "BEGIN CERTIFICATE" "$CERT"; then
  echo "[INFO] Détails certificat serveur :"
  openssl x509 -in "$CERT" -noout \
    -subject -issuer -dates -fingerprint -sha256 2>/dev/null | sed 's/^/  /'
else
  echo "[ERREUR] Aucun certificat extrait."
fi