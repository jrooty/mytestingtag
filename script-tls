#!/bin/bash
# Test TCP/TLS/mTLS et affichage du certificat serveur - compatible OpenSSL 1.0.2

if [[ "$1" == "--target" ]]; then
  TARGET="$2"
else
  TARGET="$1"
fi

if [[ -z "$TARGET" ]]; then
  echo "Usage : $0 [--target] <ip:port>"
  exit 1
fi

IP="${TARGET%%:*}"
PORT="${TARGET##*:}"
SNI="$IP"

CLIENT_CERT="client.crt"
CLIENT_KEY="client.key"
CA_FILE="ca.crt"
USE_MTLS=0
[[ -f "$CLIENT_CERT" && -f "$CLIENT_KEY" && -f "$CA_FILE" ]] && USE_MTLS=1

echo "[INFO] Connexion à $IP:$PORT (SNI=$SNI)"
tcp_res="KO"; tls_res="KO"; mtls_res="N/A"

# ---------- test TCP ----------
if timeout 3 bash -c "echo > /dev/tcp/$IP/$PORT" 2>/dev/null; then
  tcp_res="OK"

  # ---------- test TLS ----------
  if openssl s_client -connect "$IP:$PORT" -servername "$SNI" -showcerts </dev/null 2>&1 | grep -q "BEGIN CERTIFICATE"; then
    tls_res="OK"
  fi

  # ---------- test mTLS ----------
  if (( USE_MTLS )); then
    # Test mTLS réel
    if openssl s_client -connect "$IP:$PORT" -servername "$SNI" \
         -cert "$CLIENT_CERT" -key "$CLIENT_KEY" -CAfile "$CA_FILE" </dev/null 2>&1 | grep -q "BEGIN CERTIFICATE"; then
      mtls_res="OK"
    else
      mtls_res="REQ"
    fi
  else
    # Vérifie si le serveur demande un cert client
    if openssl s_client -connect "$IP:$PORT" -servername "$SNI" </dev/null 2>&1 | grep -q "Acceptable client certificate CA names"; then
      mtls_res="REQ"
    else
      mtls_res="N/A"
    fi
  fi
fi

# ---------- affichage résultats ----------
GREEN="\033[32m"; RED="\033[31m"; YELLOW="\033[33m"; RESET="\033[0m"
[[ "$tcp_res" == "OK" ]] && tcp_col="${GREEN}OK${RESET}" || tcp_col="${RED}KO${RESET}"
[[ "$tls_res" == "OK" ]] && tls_col="${GREEN}OK${RESET}" || tls_col="${RED}KO${RESET}"
case "$mtls_res" in
  OK) mtls_col="${GREEN}OK${RESET}" ;;
  REQ) mtls_col="${YELLOW}REQ${RESET}" ;;
  N/A) mtls_col="${RED}N/A${RESET}" ;;
  *) mtls_col="${RED}KO${RESET}" ;;
esac

echo -e "Résultats : TCP=${tcp_col} TLS=${tls_col} mTLS=${mtls_col}"
echo

# ---------- affichage certificat serveur ----------
if [[ "$tls_res" == "OK" ]]; then
  TMP_CERT=$(mktemp)
  trap 'rm -f "$TMP_CERT"' EXIT
  echo "[INFO] Détails certificat serveur :"

  openssl s_client -connect "$IP:$PORT" -servername "$SNI" -showcerts </dev/null 2>&1 \
    | awk '/-----BEGIN CERTIFICATE-----/{p=1} p{print} /-----END CERTIFICATE-----/{exit}' \
    | tr -d '\r' > "$TMP_CERT"

  if grep -q "BEGIN CERTIFICATE" "$TMP_CERT"; then
    openssl x509 -in "$TMP_CERT" -noout \
      -subject -issuer -dates -fingerprint -sha256 2>/dev/null | sed 's/^/  /'
  else
    echo "  (aucun certificat trouvé dans le flux)"
  fi
  echo
fi

# ---------- CA acceptées ----------
echo "[INFO] CA acceptées par le serveur (si fournies) :"
openssl s_client -connect "$IP:$PORT" -servername "$SNI" </dev/null 2>&1 \
  | awk '/Acceptable client certificate CA names/{flag=1;next} flag && NF{print "  "$0} flag && /^$/{flag=0}'
echo

# ---------- infos locales mTLS ----------
if (( USE_MTLS )); then
  echo "[INFO] Matériel client mTLS local :"
  subj_client=$(openssl x509 -in "$CLIENT_CERT" -noout -subject 2>/dev/null | sed 's/^subject= *//')
  iss_client=$(openssl x509 -in "$CLIENT_CERT" -noout -issuer  2>/dev/null | sed 's/^issuer= *//')
  subj_ca=$(openssl x509 -in "$CA_FILE"     -noout -subject 2>/dev/null | sed 's/^subject= *//')
  iss_ca=$(openssl x509 -in "$CA_FILE"      -noout -issuer  2>/dev/null | sed 's/^issuer= *//')
  echo "  Client cert (subject): ${subj_client}"
  echo "  Client cert (issuer) : ${iss_client}"
  echo "  CA locale (subject)  : ${subj_ca}"
  echo "  CA locale (issuer)   : ${iss_ca}"
  echo
else
  echo "[INFO] Aucun certificat client trouvé localement (pas de test mTLS)."
fi