#!/bin/bash
set -e
TMP_POOLS=$(mktemp)
TMP_AS3=$(mktemp)

# 1️⃣ Récupérer tous les pools via iControl REST
curl -sS --insecure -u admin: http://localhost:8100/mgmt/tm/ltm/pool?expandSubcollections=true -o "$TMP_POOLS"

# 2️⃣ Lister pools iControl
jq -r '.items? // [] | .[] | .name' "$TMP_POOLS" > pools_list.txt

# 3️⃣ Récupérer déclaration AS3
curl -sS --insecure -u admin: http://localhost:8100/mgmt/shared/appsvcs/declare -o "$TMP_AS3"

# 4️⃣ Matching pool iControl → pool AS3
echo "Matching pools iControl → AS3 :"
while read -r POOL_NAME; do
    AS3_EXISTS=$(jq -e --arg p "$POOL_NAME" '.. | objects | select(.class=="Pool" and .name==$p) // empty' "$TMP_AS3")
    if [ -n "$AS3_EXISTS" ]; then
        echo "Pool=${POOL_NAME} AS3_FOUND=OK"
    else
        echo "Pool=${POOL_NAME} AS3_FOUND=KO"
    fi
done < pools_list.txt

rm -f "$TMP_POOLS" "$TMP_AS3"