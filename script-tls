#!/bin/bash
# Classement des Virtual Servers BIG-IP : fastl4 / https / http / other
# Fonctionne sur toutes partitions. Nécessite tmsh.

set -eo pipefail

# -- Inventaire des profils (chemins complets /Partition/Nom). Tolère absence d’une classe.
tmsh -q -c 'cd /; list ltm profile fastl4   recursive one-line' | sed -n 's/^ltm profile fastl4 \([^ ]\+\).*/\1/p' > /tmp/_fastl4.lst  || true
tmsh -q -c 'cd /; list ltm profile client-ssl recursive one-line' | sed -n 's/^ltm profile client-ssl \([^ ]\+\).*/\1/p' > /tmp/_clientssl.lst || true
tmsh -q -c 'cd /; list ltm profile http     recursive one-line' | sed -n 's/^ltm profile http \([^ ]\+\).*/\1/p' > /tmp/_http.lst     || true

# Si une liste est vide, on met quelque chose d’inoffensif pour grep -f
for f in /tmp/_fastl4.lst /tmp/_clientssl.lst /tmp/_http.lst; do
  if [ ! -s "$f" ]; then echo "__no_profile__" > "$f"; fi
done

# En-tête
printf "%-28s %-40s %-24s %-8s\n" "PARTITION" "VS_NAME" "DESTINATION" "TYPE"

# -- Tous les VS (une ligne par VS, toutes partitions)
tmsh -q -c 'cd /; list ltm virtual recursive one-line' 2>/dev/null | while IFS= read -r line; do
  # Chemin VS (/Partition/VS)
  vs_path=$(awk '{for (i=1;i<=NF;i++) if ($i=="virtual") {print $(i+1); break}}' <<<"$line")
  [ -z "$vs_path" ] && continue
  part="${vs_path%/*}"; part="${part#/}"
  vs_name="${vs_path##*/}"

  # Destination (IP:port)
  dest=$(awk '{for (i=1;i<=NF;i++) if ($i=="destination") {print $(i+1); break}}' <<<"$line")
  [[ "$dest" == */*:* ]] && dest="${dest##*/}"

  # Profils attachés (bloc inline si présent)
  prof_block=$(sed -n 's/.*profiles { \(.*\) }.*/\1/p' <<<"$line" || true)
  # Fallback: récupérer les profils du VS si le bloc n’est pas dans la “one-line”
  if [ -z "$prof_block" ]; then
    vs_prof_line=$(tmsh -q -c "list ltm virtual ${vs_path} profiles one-line" 2>/dev/null || true)
    prof_block=$(sed -n 's/.*profiles { \(.*\) }.*/\1/p' <<<"$vs_prof_line" || true)
  fi

  # Détection par priorité : fastl4 > https (client-ssl) > http > other
  vs_type="other"

  # 1) fastl4 ?
  #   - si un des profils attachés correspond à un chemin de /tmp/_fastl4.lst
  #   - ou si le mot 'fastl4' apparait brut (rare mais possible)
  if echo "$prof_block" | grep -Ff /tmp/_fastl4.lst -q || grep -qw fastl4 <<<"$prof_block"; then
    vs_type="fastl4"
  else
    # 2) https ? (client-ssl)
    #   - match sur chemins connus
    #   - OU présence du token 'clientssl' brut (profil par défaut sans chemin)
    if echo "$prof_block" | grep -Ff /tmp/_clientssl.lst -q || grep -qw clientssl <<<"$prof_block"; then
      vs_type="https"
    else
      # 3) http ?
      #   - match sur chemins de profils http
      #   - OU token 'http' brut
      if echo "$prof_block" | grep -Ff /tmp/_http.lst -q || grep -qw http <<<"$prof_block"; then
        vs_type="http"
      fi
    fi
  fi

  printf "%-28s %-40s %-24s %-8s\n" "$part" "$vs_name" "${dest:-"-"}" "$vs_type"
done