openssl s_client -connect 1.2.3.4:443 -showcerts </dev/null > /tmp/out.txt 2>&1
grep -n "BEGIN CERTIFICATE" /tmp/out.txt | head -n 5
xxd -l 32 /tmp/out.txt

awk '/-----BEGIN CERTIFICATE-----/{f=1} f{print}' /tmp/out.txt | sed -n '/-----END CERTIFICATE-----/q;p' | \
  LC_ALL=C tr -cd '\11\12\15\40-\176' > /tmp/clean.pem
openssl x509 -in /tmp/clean.pem -noout -subject -issuer -dates -fingerprint -sha256