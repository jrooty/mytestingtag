#!/bin/bash
set -euo pipefail

# Parcourt toutes les partitions et classe chaque VS :
# - fastl4  : si un profil fastl4 est attaché
# - https   : si un profil client-ssl (peu importe son nom) est attaché côté VS
# - http    : si un profil http est attaché (et pas client-ssl / fastl4)
# - other   : sinon

# 1) Récupérer les profils disponibles par type (chemins complets /Partition/Nom)
mapfile -t CLIENTSSL_PROFILES < <(tmsh -q -c 'cd /; list ltm profile client-ssl recursive one-line' \
  | sed -n 's/^ltm profile client-ssl \([^ ]\+\).*/\1/p')

mapfile -t HTTP_PROFILES < <(tmsh -q -c 'cd /; list ltm profile http recursive one-line' \
  | sed -n 's/^ltm profile http \([^ ]\+\).*/\1/p')

mapfile -t FASTL4_PROFILES < <(tmsh -q -c 'cd /; list ltm profile fastl4 recursive one-line' \
  | sed -n 's/^ltm profile fastl4 \([^ ]\+\).*/\1/p')

# Convertir en "ensembles" bash (associatifs) pour lookup O(1)
declare -A SET_CLIENTSSL SET_HTTP SET_FASTL4
for p in "${CLIENTSSL_PROFILES[@]}"; do SET_CLIENTSSL["$p"]=1; done
for p in "${HTTP_PROFILES[@]}";     do SET_HTTP["$p"]=1;     done
for p in "${FASTL4_PROFILES[@]}";   do SET_FASTL4["$p"]=1;   done

# 2) Récupérer tous les VS (toutes partitions) en one-line
mapfile -t VS_LINES < <(tmsh -q -c 'cd /; list ltm virtual recursive one-line' 2>/dev/null || true)

# En-tête
printf "%-28s %-40s %-22s %-8s\n" "PARTITION" "VS_NAME" "DESTINATION" "TYPE"

for line in "${VS_LINES[@]}"; do
  # Chemin VS /Partition/Name
  vs_path=$(awk '{for (i=1;i<=NF;i++) if ($i=="virtual") {print $(i+1); break}}' <<<"$line")
  [[ -z "$vs_path" ]] && continue
  part="${vs_path%/*}"; part="${part#/}"
  vs_name="${vs_path##*/}"

  # Destination (IP:port)
  dest=$(awk '{for (i=1;i<=NF;i++) if ($i=="destination") {print $(i+1); break}}' <<<"$line")
  [[ "$dest" == */*:* ]] && dest="${dest##*/}"

  # Extraire le bloc profiles {...} puis tous les chemins /Partition/Profil
  prof_block=$(sed -n 's/.*profiles { \(.*\) }.*/\1/p' <<<"$line" || true)
  # Quand le bloc est absent sur cette ligne (selon versions), on requête ciblé
  if [[ -z "$prof_block" ]]; then
    # Récupérer les profils de ce VS uniquement (one-line)
    vs_profiles_line=$(tmsh -q -c "list ltm virtual ${vs_path} profiles one-line" 2>/dev/null || true)
    prof_block=$(sed -n 's/.*profiles { \(.*\) }.*/\1/p' <<<"$vs_profiles_line" || true)
  fi

  # Liste des profils attachés (chemins complets)
  # On matche des tokens /Partition/Nom juste avant une accolade ou un espace
  readarray -t ATTACHED < <(grep -oE '/[^ /]*/[^ {]+' <<<"$prof_block" || true)

  # Déterminer le type par priorité : fastl4 > https (client-ssl) > http > other
  vs_type="other"

  # fastl4 ?
  for p in "${ATTACHED[@]}"; do
    if [[ -n "${SET_FASTL4["$p"]+x}" ]]; then vs_type="fastl4"; break; fi
  done

  # https (client-ssl) si pas déjà fastl4
  if [[ "$vs_type" == "other" ]]; then
    for p in "${ATTACHED[@]}"; do
      if [[ -n "${SET_CLIENTSSL["$p"]+x}" ]]; then vs_type="https"; break; fi
    done
  fi

  # http si ni fastl4 ni https
  if [[ "$vs_type" == "other" ]]; then
    for p in "${ATTACHED[@]}"; do
      if [[ -n "${SET_HTTP["$p"]+x}" ]]; then vs_type="http"; break; fi
    done
  fi

  printf "%-28s %-40s %-22s %-8s\n" "$part" "$vs_name" "${dest:-"-"}" "$vs_type"
done