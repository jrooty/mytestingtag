#!/bin/bash
# Audit VS + tests TCP/TLS/mTLS + mode direct --target
# Compatible F5 iControl REST (http://localhost:8100, admin:)
# Par defaut: ne teste que les VS avec C3D=ON; utiliser --all-vs pour tout
# Duree entre members: --sleep-ms=N (200 ms par defaut)

set -euo pipefail

DEBUG=0
ALL_VS=0
SLEEP_MS=200
TARGET=""
SNI=""

# ---------- Parsing options ----------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --debug) DEBUG=1; shift ;;
    --all-vs) ALL_VS=1; shift ;;
    --sleep-ms=*) SLEEP_MS="${1#*=}"; shift ;;
    --sleep-ms) shift; SLEEP_MS="${1:-200}"; shift || true ;;
    --target=*) TARGET="${1#*=}"; shift ;;
    --target) shift; TARGET="${1:-}"; shift || true ;;
    --sni=*) SNI="${1#*=}"; shift ;;
    --sni) shift; SNI="${1:-}"; shift || true ;;
    *) break ;;
  esac
done

SLEEP_SEC=$(awk "BEGIN { printf \"%.3f\", ${SLEEP_MS} / 1000 }")

CLIENT_CERT="client.crt"
CLIENT_KEY="client.key"
CA_FILE="ca.crt"
USE_MTLS=0
[[ -f "$CLIENT_CERT" && -f "$CLIENT_KEY" && -f "$CA_FILE" ]] && USE_MTLS=1

# ---------- Fonctions ----------
extract_first_cert_from_sclient() {
  awk '/-----BEGIN CERTIFICATE-----/{p=1} p{print} /-----END CERTIFICATE-----/{exit}'
}

print_server_cert_details() {
  openssl x509 -noout \
    -subject -issuer -dates -fingerprint -sha256 -ext subjectAltName 2>/dev/null
}

list_server_acceptable_cas() {
  local ip="$1" port="$2" sni_host="$3"
  if [[ -n "$sni_host" ]]; then
    openssl s_client -connect "${ip}:${port}" -servername "${sni_host}" </dev/null 2>&1 \
    | awk '/Acceptable client certificate CA names/{flag=1;next} flag && NF{print} flag && /^$/{flag=0}'
  else
    openssl s_client -connect "${ip}:${port}" </dev/null 2>&1 \
    | awk '/Acceptable client certificate CA names/{flag=1;next} flag && NF{print} flag && /^$/{flag=0}'
  fi
}

# =========================
# MODE DIRECT --target
# =========================
if [[ -n "$TARGET" ]]; then
  IP="${TARGET%%:*}"
  PORT="${TARGET##*:}"
  [[ -z "$SNI" ]] && SNI="$IP"

  echo "[INFO] Mode direct --target: ${IP}:${PORT}"
  echo

  tcp_res="KO"; tls_res="KO"; mtls_res="KO"

  # Test TCP
  if timeout 3 bash -c "echo > /dev/tcp/$IP/$PORT" 2>/dev/null; then
    tcp_res="OK"

    # Test TLS simple
    if timeout 8 openssl s_client -connect "$IP:$PORT" -servername "$SNI" </dev/null 2>&1 \
        | grep "BEGIN CERTIFICATE" >/dev/null 2>&1; then
      tls_res="OK"
    fi

    # Test mTLS si matériel présent
    if (( USE_MTLS )); then
      if timeout 8 openssl s_client -connect "$IP:$PORT" -servername "$SNI" \
           -cert "$CLIENT_CERT" -key "$CLIENT_KEY" -CAfile "$CA_FILE" </dev/null 2>&1 \
           | grep "BEGIN CERTIFICATE" >/dev/null 2>&1; then
        mtls_res="OK"
      else
        mtls_res="REQ"
      fi
    fi
  fi

  GREEN="\033[32m"; RED="\033[31m"; YELLOW="\033[33m"; BOLD="\033[1m"; RESET="\033[0m"
  [[ "$tcp_res" == "OK" ]] && tcp_col="${GREEN}OK${RESET}" || tcp_col="${RED}KO${RESET}"
  [[ "$tls_res" == "OK" ]] && tls_col="${GREEN}OK${RESET}" || tls_col="${RED}KO${RESET}"
  case "$mtls_res" in
    OK) mtls_col="${GREEN}OK${RESET}" ;;
    REQ) mtls_col="${YELLOW}REQ${RESET}" ;;
    *) mtls_col="${RED}KO${RESET}" ;;
  esac

  echo -e "${BOLD}Cible:${RESET} ${IP}:${PORT}   ${BOLD}SNI:${RESET} ${SNI}"
  echo -e "${BOLD}Résultats:${RESET}  TCP=${tcp_col}  TLS=${tls_col}  mTLS=${mtls_col}"
  echo

  # ----- Détails certificat serveur -----
  if [[ "$tls_res" == "OK" ]]; then
    echo "[INFO] Détails certificat serveur :"
    if [[ -n "$SNI" ]]; then
      openssl s_client -connect "${IP}:${PORT}" -servername "${SNI}" -showcerts </dev/null 2>&1 \
        | extract_first_cert_from_sclient \
        | print_server_cert_details \
        | sed 's/^/  /'
    else
      openssl s_client -connect "${IP}:${PORT}" -showcerts </dev/null 2>&1 \
        | extract_first_cert_from_sclient \
        | print_server_cert_details \
        | sed 's/^/  /'
    fi
    echo
  fi

  # ----- Infos mTLS locales et CA acceptées -----
  if (( USE_MTLS )); then
    echo "[INFO] Matériel client mTLS local :"
    subj_client=$(openssl x509 -in "$CLIENT_CERT" -noout -subject 2>/dev/null | sed 's/^subject= *//')
    iss_client=$(openssl x509 -in "$CLIENT_CERT" -noout -issuer  2>/dev/null | sed 's/^issuer= *//')
    subj_ca=$(openssl x509 -in "$CA_FILE"     -noout -subject 2>/dev/null | sed 's/^subject= *//')
    iss_ca=$(openssl x509 -in "$CA_FILE"      -noout -issuer  2>/dev/null | sed 's/^issuer= *//')
    echo "  Client cert (subject): ${subj_client}"
    echo "  Client cert (issuer) : ${iss_client}"
    echo "  CA locale (subject)  : ${subj_ca}"
    echo "  CA locale (issuer)   : ${iss_ca}"
    echo
    echo "[INFO] (Best effort) CA acceptées par le serveur pour le client cert :"
    cas=$(list_server_acceptable_cas "$IP" "$PORT" "$SNI")
    if [[ -n "$cas" ]]; then
      echo "$cas" | sed 's/^/  /'
    else
      echo "  (non disponible ou non fourni par le serveur)"
    fi
    echo
  else
    echo "[INFO] mTLS non activé localement (fichiers manquants : $CLIENT_CERT, $CLIENT_KEY, $CA_FILE)."
  fi

  exit 0
fi

# =========================
# MODE NORMAL F5
# =========================
F5_HOST="localhost:8100"
BASE="http://$F5_HOST"
AUTH="admin:"
VS_URL="$BASE/mgmt/tm/ltm/virtual?expandSubcollections=true"
POOL_URL="$BASE/mgmt/tm/ltm/pool?expandSubcollections=true"

TMP_VS=$(mktemp)
TMP_POOL=$(mktemp)
TMP_SSL=$(mktemp)
trap 'rm -f "$TMP_VS" "$TMP_POOL" "$TMP_SSL"' EXIT

curl -sS --insecure -u "$AUTH" "$VS_URL" -o "$TMP_VS"
total_vs=$(jq -r '.items | length' "$TMP_VS" 2>/dev/null || echo 0)
total_ssl=$(jq -r '.items[].profilesReference.items[].nameReference.link?' "$TMP_VS" 2>/dev/null | grep -c "ltm/profile/server-ssl/" || true)

echo -e "\n[INFO] Nombre total de Virtual Servers : ${total_vs}"
echo -e "[INFO] Nombre de Virtual Servers avec profil server-ssl : ${total_ssl}"
echo -e "[INFO] Délai entre tests de membres : ${SLEEP_MS} ms"
if (( ALL_VS )); then
  echo -e "[INFO] Mode sélectionné : Tous les Virtual Servers (--all-vs)"
else
  echo -e "[INFO] Mode sélectionné : Seulement les VS avec C3D activé (par défaut)"
fi
echo
# --- reste du mode F5 inchangé ---