#!/bin/bash
set -e

F5_USER="admin:"
F5_URL="http://localhost:8100"
TMP_AS3=$(mktemp)
TMP_POOLS=$(mktemp)

# 1️⃣ Récupère les pools iControl
echo "[INFO] Récupération des pools via iControl..."
curl -sS --insecure -u "$F5_USER" "$F5_URL/mgmt/tm/ltm/pool" | jq -r '.items[].name' > "$TMP_POOLS"

# 2️⃣ Récupère la déclaration AS3 complète
echo "[INFO] Récupération de la déclaration AS3..."
curl -sS --insecure -u "$F5_USER" "$F5_URL/mgmt/shared/appsvcs/declare" -o "$TMP_AS3"

# 3️⃣ Corrélation entre pool iControl et AS3
echo
echo "=== Corrélation des pools ==="
while read -r pool; do
    # Recherche dans l’arborescence AS3 si le nom du pool est une clé
    match=$(jq -r --arg POOL "$pool" '
        paths
        | select(.[-1] == $POOL)
        | map(tostring)
        | join(".")
    ' "$TMP_AS3")

    if [ -n "$match" ]; then
        # Vérifie si ce pool est référencé dans un VS
        vs_name=$(jq -r --arg POOL "$pool" '
            .. | objects | select(has("class"))
            | select(.class | test("Service_"; "i"))
            | select(.pool == $POOL)
            | .name // empty
        ' "$TMP_AS3")

        if [ -n "$vs_name" ]; then
            echo "✅ Pool '$pool' trouvé dans AS3 → associé à VS '$vs_name'"
        else
            echo "⚠️  Pool '$pool' trouvé dans AS3 (aucun VS lié)"
        fi
    else
        echo "❌ Pool '$pool' non trouvé dans la déclaration AS3"
    fi
done < "$TMP_POOLS"

# Nettoyage
rm -f "$TMP_AS3" "$TMP_POOLS"